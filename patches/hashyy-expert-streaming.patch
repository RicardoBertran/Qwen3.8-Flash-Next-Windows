+void llama_moe_stream::open_files(const std::vector<std::string> & paths) {
+    for (const auto & path : paths) {
+        if (path.empty()) {
+            throw std::runtime_error("MoE expert streaming requires a file-based model (not a stream/file descriptor)");
+        }
+    }
+
+    auto open_all = [&](bool direct) {
+        files.clear();
+        for (const auto & path : paths) {
+            files.emplace_back(new llama_file(path.c_str(), "rb", direct));
+        }
+    };
+
+    open_all(use_direct_io);
+
+#ifdef _WIN32
+    // One handle per I/O worker per file. A synchronous Windows file object serializes every
+    // ReadFile issued through it, so sharing one handle across the workers pins the drive to
+    // queue depth 1 - see the note on h_rand in the header and bench/qd.py for the measurement.
+    auto open_extra = [&](DWORD flags, std::vector<std::vector<void *>> & out, const char * what) {
+        const size_t n_sets = (size_t) (n_io_threads > 0 ? n_io_threads : 1);
+        out.assign(n_sets, std::vector<void *>(paths.size(), nullptr));
+        bool ok = true;
+        for (size_t w = 0; w < n_sets && ok; w++) {
+            for (size_t i = 0; i < paths.size(); i++) {
+                const int wlen = MultiByteToWideChar(CP_UTF8, 0, paths[i].c_str(), -1, nullptr, 0);
+                std::wstring wpath(wlen > 0 ? wlen - 1 : 0, 0);
+                if (wlen > 0) {
+                    MultiByteToWideChar(CP_UTF8, 0, paths[i].c_str(), -1, wpath.data(), wlen);
+                }
+                HANDLE h = CreateFileW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                        OPEN_EXISTING, flags, nullptr);
+                if (h == INVALID_HANDLE_VALUE) {
+                    LLAMA_LOG_WARN("%s: cannot open %s for %s, falling back\n", __func__, paths[i].c_str(), what);
+                    ok = false;
+                    break;
+                }
+                out[w][i] = (void *) h;
+            }
+        }
+        if (!ok) {
+            for (auto & per_file : out) {
+                for (void * p : per_file) {
+                    if (p != nullptr) {
+                        CloseHandle((HANDLE) p);
+                    }
+                }
+            }
+            out.clear();
+            return;
+        }
+        LLAMA_LOG_INFO("%s: %zu handle sets x %zu files for %s\n", __func__, out.size(), paths.size(), what);
+    };
+
+    if (admit_lo > 0 || admit_hi < UINT32_MAX) {
+        open_extra(FILE_FLAG_NO_BUFFERING | FILE_FLAG_RANDOM_ACCESS, h_nobuf, "page-cache admission");
+    }
+    if (use_random_access) {
+        open_extra(FILE_FLAG_RANDOM_ACCESS, h_rand, "random-access reads");
+    }
+#endif
+
+    // fall back to buffered when O_DIRECT is unusable: either the open did not honor it (macOS,
+    // Windows, unsupported filesystems), or it opened but a probe read fails (some network/overlay
+    // filesystems accept the flag then reject aligned reads). reopening is needed because O_DIRECT
+    // is a property of the fd. done here, single-threaded, before any worker starts.
+    if (use_direct_io) {
+        bool ok = !files.empty() && files.front()->has_direct_io();
+        if (ok) {
+            uint8_t * probe = (uint8_t *) moe_aligned_alloc(MOE_STREAM_DIRECT_ALIGN);
+            GGML_ASSERT(probe != nullptr);
+            ok = llama_moe_stream_pread(*files.front(), probe, MOE_STREAM_DIRECT_ALIGN, 0, /*direct =*/ true) != nullptr;
+            moe_aligned_free(probe);
+        }
+        if (!ok) {
+            LLAMA_LOG_WARN("%s: O_DIRECT not usable, falling back to buffered streaming reads\n", __func__);
+            use_direct_io = false;
+            open_all(false);
+        }
+    }
+
+    if (use_direct_io) {
+        LLAMA_LOG_INFO("%s: MoE expert streaming uses O_DIRECT (page cache bypassed)\n", __func__);
+    }
+
+    // one token drives ~one remap per streamed layer, so decaying every 64 tokens is
+    //   64 * n_streamed_layers remap calls (computed once here, off the hot path)
+    int64_t n_streamed = 0;
+    for (const auto & sl : layers) {
+        n_streamed += sl != nullptr;
+    }
+    hot_decay_interval = MOE_STREAM_HOT_DECAY_TOKENS * n_streamed;
+
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_HOT")) {
+        hot_path = e;
+        open_hot_file();
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_HEAT")) {
+        heat_path = e;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_WARM_GB")) {
+        warm_extra_gb = atof(e);
+    }
+    // Drop the loader's footprint from the working set.
+    //
+    // The non-expert weights (4.21 GiB here) are read through the mmap at load, copied to VRAM
+    // and never touched again, but they stay in this process's working set as active pages, so
+    // the page cache - which is the only L2 the expert stream has - is that much smaller.
+    // EmptyWorkingSet moves them to the standby list, where they are ordinary reclaimable cache
+    // and the oldest thing on it, so expert slabs get the space instead. Pages that are still
+    // wanted come back as soft faults off standby, which cost no I/O.
+#ifdef _WIN32
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_TRIM")) {
+        if (atoi(e) == 0) {
+            goto no_trim;
+        }
+    }
+    {
+        PROCESS_MEMORY_COUNTERS before = {}, after = {};
+        before.cb = after.cb = sizeof(PROCESS_MEMORY_COUNTERS);
+        GetProcessMemoryInfo(GetCurrentProcess(), &before, sizeof(before));
+        if (EmptyWorkingSet(GetCurrentProcess())) {
+            GetProcessMemoryInfo(GetCurrentProcess(), &after, sizeof(after));
+            LLAMA_LOG_INFO("%s: working set trimmed %.2f -> %.2f GiB\n", __func__,
+                    before.WorkingSetSize/1073741824.0, after.WorkingSetSize/1073741824.0);
+        }
+    }
+no_trim:;
+#endif
+
+    if (!heat_path.empty()) {
+        heat_save_every = 256 * n_streamed; // ~256 tokens
+        warm_from_heat();
+    }
+}
+
+
+// ---------------------------------------------------------------------------
+// Heat-ranked host-RAM L2 for streamed expert slabs.
+//
+// The device cache (L1) is capped by VRAM. Without this, every L1 miss goes to
+// the GGUF file. On a consumer NVMe that is ~1.1 GB/s at expert granularity,
+// while a host->device copy runs at PCIe speed (~12 GB/s on gen3 x16), so an
+// L2 hit replaces a disk read with a copy an order of magnitude faster.
+//
+// The OS page cache is an accidental L2, but it evicts by LRU over every page
+// of the file (including the multi-GiB per-layer embedding table). This tier
+// holds expert slabs only and evicts the coldest by decaying access heat.
+//
+// Enable with LLAMA_MOE_STREAM_L2_GB=<n>. Disabled (0) by default.
+// Host-RAM L2 for streamed expert slabs, and the staging buffer at the same time.
+//
+// The tier only pays off if it adds no copy: a slab is read from the GGUF straight into its arena
+// entry, and uploaded to the device from there. An L2 hit is then one DMA out of host RAM, and an
+// L2 miss is one read plus that same DMA - exactly what the no-L2 path costs, so the arena is free
+// except for the RAM it takes from the OS page cache.
+//
+// Capacity is the whole game here, and an explicit tier can rank by route hotness where the page
+// cache only sees LRU over a 76 GiB file. Enable with LLAMA_MOE_STREAM_L2_GB=<n>, default off.
+struct moe_l2_cache {
+    struct pool {
+        size_t    slab = 0; // bytes per entry, rounded up for sector-aligned reads
+        size_t    len  = 0; // useful bytes
+        uint32_t  n    = 0;
+        uint8_t * base = nullptr;
+
+        std::vector<uint64_t> key;
+        std::vector<uint8_t>  valid; // 0 while a reservation is still being read
+        std::vector<uint8_t>  ref;   // CLOCK reference bit
+        std::vector<uint16_t> pin;   // uploads in flight, never evicted
+
+        std::unordered_map<uint64_t, uint32_t> map;
+
+        uint32_t hand = 0;
+        uint32_t used = 0;
+    };
+
+    std::mutex            mtx;
+    uint8_t *             arena       = nullptr;
+    ggml_backend_buffer_t pinned_buf  = nullptr; // non-null when the arena is pinned
+    size_t                arena_bytes = 0;
+    std::vector<pool> pools;
+    uint64_t          hits = 0, misses = 0;
+    bool              ready = false;
+
+    static size_t align_up(size_t v, size_t a) { return (v + a - 1) & ~(a - 1); }
+
+    // pinned_buft, when given, makes the arena pinned host memory, so a hit can be uploaded
+    // with a direct DMA instead of being copied into the staging buffer first
+    void init(const std::vector<size_t> & sizes, ggml_backend_buffer_type_t pinned_buft) {
+        std::lock_guard<std::mutex> lk(mtx);
+        if (ready) {
+            return;
+        }
+        ready = true;
+
+        const char * e  = getenv("LLAMA_MOE_STREAM_L2_GB");
+        const double gb = e ? atof(e) : 0.0;
+        if (gb <= 0.0 || sizes.empty()) {
+            return;
+        }
+
+        // budget whole experts: an expert is only useful with all of its weights resident
+        size_t per_expert = 0;
+        for (size_t s : sizes) {
+            per_expert += align_up(s, MOE_STREAM_DIRECT_ALIGN);
+        }
+        if (per_expert == 0) {
+            return;
+        }
+
+        const size_t n_entries = (size_t) (gb * 1024.0*1024.0*1024.0) / per_expert;
+        if (n_entries == 0) {
+            return;
+        }
+
+        arena_bytes = n_entries * per_expert;
+        if (pinned_buft != nullptr) {
+            pinned_buf = ggml_backend_buft_alloc_buffer(pinned_buft, arena_bytes);
+            if (pinned_buf != nullptr) {
+                arena = (uint8_t *) ggml_backend_buffer_get_base(pinned_buf);
+                if (((uintptr_t) arena) % MOE_STREAM_DIRECT_ALIGN != 0) {
+                    ggml_backend_buffer_free(pinned_buf);
+                    pinned_buf = nullptr;
+                    arena      = nullptr;
+                }
+            }
+        }
+        if (arena == nullptr) {
+            // WDDM can refuse a pinning this large; a pageable arena still works, it just
+            // costs the extra copy
+            arena = (uint8_t *) moe_aligned_alloc(arena_bytes);
+        }
+        if (arena == nullptr) {
+            arena_bytes = 0;
+            return;
+        }
+
+        uint8_t * p = arena;
+        pools.resize(sizes.size());
+        for (size_t i = 0; i < sizes.size(); i++) {
+            auto & pl = pools[i];
+            pl.len  = sizes[i];
+            pl.slab = align_up(sizes[i], MOE_STREAM_DIRECT_ALIGN);
+            pl.n    = (uint32_t) n_entries;
+            pl.base = p;
+            p      += (size_t) n_entries * pl.slab;
+            pl.key  .assign(n_entries, 0);
+            pl.valid.assign(n_entries, 0);
+            pl.ref  .assign(n_entries, 0);
+            pl.pin  .assign(n_entries, 0);
+            pl.map.reserve(n_entries * 2);
+        }
+
+        LLAMA_LOG_INFO("%s: MoE L2 host cache: %.2f GiB, %zu experts\n",
+                __func__, (double) arena_bytes/(1024.0*1024.0*1024.0), n_entries);
+        fprintf(stderr, "moe stream: L2 host cache %.2f GiB, %zu experts, %zu pools, %s\n",
+                (double) arena_bytes/(1024.0*1024.0*1024.0), n_entries, pools.size(),
+                pinned_buf != nullptr ? "pinned (uploads DMA from the arena)" : "pageable");
+        fflush(stderr);
+    }
+
+    bool enabled()   const { return arena != nullptr; }
+    bool is_pinned() const { return pinned_buf != nullptr; }
+
+    pool * pool_for(size_t len) {
+        for (auto & pl : pools) {
+            if (pl.len == len) {
+                return &pl;
+            }
+        }
+        return nullptr;
+    }
+
+    // a pinned entry: the slab stays put until release(), so the caller can read into it and
+    // upload out of it with the lock dropped
+    struct ref_t {
+        uint8_t * ptr  = nullptr;
+        pool *    pl   = nullptr;
+        uint32_t  idx  = 0;
+        bool      fill = false; // true when the caller must still read the bytes in
+    };
+
+    // resident entry for key, or a reserved empty one to read into
+    ref_t acquire(uint64_t key, size_t len) {
+        ref_t r;
+        if (arena == nullptr) {
+            return r;
+        }
+        std::lock_guard<std::mutex> lk(mtx);
+        pool * pl = pool_for(len);
+        if (pl == nullptr) {
+            return r;
+        }
+
+        auto it = pl->map.find(key);
+        if (it != pl->map.end()) {
+            const uint32_t i = it->second;
+            if (!pl->valid[i]) {
+                return r; // someone else is still reading it, use the plain path
+            }
+            pl->ref[i] = 1;
+            pl->pin[i]++;
+            hits++;
+            return { pl->base + (size_t) i*pl->slab, pl, i, false };
+        }
+        misses++;
+
+        uint32_t idx;
+        if (pl->used < pl->n) {
+            idx = pl->used++;
+        } else {
+            // CLOCK: one second chance per entry, then take it
+            uint32_t guard = 0;
+            for (;; pl->hand = (pl->hand + 1) % pl->n) {
+                const uint32_t h = pl->hand;
+                if (pl->pin[h] == 0 && pl->valid[h]) {
+                    if (pl->ref[h] == 0) {
+                        idx = h;
+                        pl->hand = (h + 1) % pl->n;
+                        break;
+                    }
+                    pl->ref[h] = 0;
+                }
+                if (++guard > 4u*pl->n) {
+                    return r; // nothing evictable right now
+                }
+            }
+            pl->map.erase(pl->key[idx]);
+        }
+
+        pl->key[idx]   = key;
+        pl->valid[idx] = 0;
+        pl->ref[idx]   = 1;
+        pl->pin[idx]   = 1;
+        pl->map[key]   = idx;
+        return { pl->base + (size_t) idx*pl->slab, pl, idx, true };
+    }
+
+    // ok=false on a failed read: drop the reservation so the entry does not serve garbage
+    void release(const ref_t & r, bool ok) {
+        if (r.pl == nullptr) {
+            return;
+        }
+        std::lock_guard<std::mutex> lk(mtx);
+        if (r.fill) {
+            if (ok) {
+                r.pl->valid[r.idx] = 1;
+            } else {
+                r.pl->map.erase(r.pl->key[r.idx]);
+                r.pl->key[r.idx] = 0;
+            }
+        }
+        r.pl->pin[r.idx]--;
+    }
+
+    ~moe_l2_cache() {
+        if (arena) {
+            if (hits + misses) {
+                LLAMA_LOG_INFO("%s: MoE L2: %llu hits / %llu lookups (%.1f%%)\n", __func__,
+                        (unsigned long long) hits, (unsigned long long)(hits+misses),
+                        100.0*(double)hits/(double)(hits+misses));
+            }
+            if (pinned_buf != nullptr) {
+                ggml_backend_buffer_free(pinned_buf);
+            } else {
+                moe_aligned_free(arena);
+            }
+        }
+    }
+};
+
+static moe_l2_cache & moe_l2() { static moe_l2_cache c; return c; }
+
+static inline uint64_t moe_l2_key(uint16_t file_idx, size_t offs) {
+    return ((uint64_t) file_idx << 56) ^ (uint64_t) offs ^ 0x9e3779b97f4a7c15ull;
+}
+
+// spawn the I/O thread pool on first use (from the remap callback, under mtx)
+void llama_moe_stream::start_workers_locked() {
+    if (workers_started) {
+        return;
+    }
+    workers_started = true;
+    if (async_upload && init_staging_pool()) {
+        uploader = std::thread([this]() { uploader_loop(); });
+    } else {
+        free_staging_pool();
+    }
+    workers.reserve(n_io_threads);
+    for (int32_t i = 0; i < n_io_threads; i++) {
+        workers.emplace_back([this, i]() { worker_loop(i); });
+    }
+}
+
+// I/O worker: pops a reserved load, reads its expert slab(s) from the GGUF file into the cache
+// slot, and marks the slot RESIDENT (or flags load_failed); stale/duplicate items are skipped
+bool llama_moe_stream::init_staging_pool() {
+    if (h2d_async == nullptr || h2d_sync == nullptr) {
+        return false;
+    }
+    auto * host_buft = pinned_buft();
+    if (host_buft == nullptr) {
+        return false;
+    }
+    // Enough slabs that every worker can hold one while the uploader still has a queue to
+    // drain; too few and the workers block on the pool instead of reading ahead.
+    n_staging      = std::max(16, 3*std::max(1, n_io_threads));
+    staging_stride = (max_nb_expert + 2*MOE_STREAM_DIRECT_ALIGN + 4095) & ~(size_t) 4095;
+    staging_buf    = ggml_backend_buft_alloc_buffer(host_buft, staging_stride*(size_t) n_staging);
+    if (staging_buf == nullptr) {
+        n_staging = 0;
+        return false;
+    }
+    staging_base = (uint8_t *) ggml_backend_buffer_get_base(staging_buf);
+    if (((uintptr_t) staging_base) % MOE_STREAM_DIRECT_ALIGN != 0) {
+        ggml_backend_buffer_free(staging_buf);
+        staging_buf  = nullptr;
+        staging_base = nullptr;
+        n_staging    = 0;
+        return false;
+    }
+    staging_free.resize(n_staging);
+    for (int32_t i = 0; i < n_staging; i++) {
+        staging_free[i] = i;
+    }
+    return true;
+}
+
+void llama_moe_stream::free_staging_pool() {
+    if (staging_buf != nullptr) {
+        ggml_backend_buffer_free(staging_buf);
+        staging_buf = nullptr;
+    }
+    staging_base = nullptr;
+    staging_free.clear();
+    n_staging = 0;
+}
+
+// Drains the upload queue onto this thread's CUDA stream and synchronizes once per drain,
+// then commits the slots. One sync per batch instead of one per slab is the difference
+// between 10.3 and 12.8 GB/s on this link, and because the copies no longer sit in the
+// middle of a worker's read loop they overlap the other workers' reads.
+void llama_moe_stream::uploader_loop() {
+    std::vector<llama_moe_stream_upload> batch;
+    std::unique_lock<std::mutex> lk(mtx);
+    while (true) {
+        cv_upload.wait(lk, [&]{ return shutting_down || !q_upload.empty(); });
+        if (shutting_down && q_upload.empty()) {
+            break;
+        }
+        batch.clear();
+        batch.reserve(q_upload.size());
+        while (!q_upload.empty()) {
+            batch.push_back(q_upload.front());
+            q_upload.pop_front();
+        }
+        lk.unlock();
+
+        const int64_t t0 = ggml_time_us();
+        for (const auto & u : batch) {
+            const auto & wt = u.sl->weights[u.widx];
+            const void * src = u.src != nullptr ? (const void *) u.src
+                                                : (const void *) (staging_base + (size_t) u.buf*staging_stride);
+            h2d_async(wt.cache, src, (size_t) u.slot*wt.nb_expert, wt.nb_expert);
+        }
+        h2d_sync();
+        const int64_t dt = ggml_time_us() - t0;
+
+        lk.lock();
+        stats.t_upload_us += dt;
+        for (const auto & u : batch) {
+            auto & sl = *u.sl;
+            const uint32_t bit = 1u << u.widx;
+            if (u.buf >= 0) {
+                staging_free.push_back(u.buf);
+            }
+            sl.slot_claimed[u.slot] &= ~bit;
+            // a reservation can have been superseded while the copy was in flight; the slab
+            // still landed in the right slot, but the slot no longer holds that expert
+            if (u.gen != sl.slot_gen[u.slot]) {
+                continue;
+            }
+            sl.slot_done[u.slot] |= bit;
+            if (sl.slot_done[u.slot] == sl.weights_mask()) {
+                sl.slot_state[u.slot] = LLAMA_MOE_STREAM_SLOT_RESIDENT;
+            }
+        }
+        cv_done.notify_all();
+        cv_upload.notify_all(); // workers may be waiting on a staging slab
+    }
+}
+
+
+// ---- page-locked hot-expert file -------------------------------------------------------
+
+const uint8_t * llama_moe_stream::hot_lookup(uint16_t file_idx, size_t src_offs, size_t nb) const {
+    if (hot_base == nullptr) {
+        return nullptr;
+    }
+    const auto it = hot_index.find(((uint64_t) file_idx << 48) | (uint64_t) src_offs);
+    if (it == hot_index.end() || it->second + nb > hot_size) {
+        return nullptr;
+    }
+    return (const uint8_t *) hot_base + it->second;
+}
+
+void llama_moe_stream::open_hot_file() {
+    if (hot_path.empty()) {
+        return;
+    }
+#ifdef _WIN32
+    if (host_lock == nullptr) {
+        LLAMA_LOG_WARN("%s: backend cannot page-lock host memory, hot file disabled\n", __func__);
+        return;
+    }
+    const std::string ipath = hot_path + ".idx";
+    FILE * ix = fopen(ipath.c_str(), "r");
+    if (ix == nullptr) {
+        LLAMA_LOG_WARN("%s: no index at %s, hot file disabled\n", __func__, ipath.c_str());
+        return;
+    }
+    char magic[16] = {};
+    int  ver = 0;
+    long long n_slabs = 0;
+    if (fscanf(ix, "%15s %d %lld", magic, &ver, &n_slabs) != 3 ||
+            strcmp(magic, "moe_hot") != 0 || ver != 2) {
+        LLAMA_LOG_WARN("%s: %s is not a v2 hot index\n", __func__, ipath.c_str());
+        fclose(ix);
+        return;
+    }
+    hot_index.reserve((size_t) n_slabs*2);
+    for (long long k = 0; k < n_slabs; k++) {
+        long long fi = 0, src = 0, nb = 0, ho = 0;
+        if (fscanf(ix, " %lld %lld %lld %lld", &fi, &src, &nb, &ho) != 4) {
+            break;
+        }
+        hot_index[((uint64_t) (uint16_t) fi << 48) | (uint64_t) src] = (size_t) ho;
+    }
+    fclose(ix);
+
+    // READ-WRITE on purpose: a read-only mapping cannot be page-locked on this platform.
+    // Nothing ever writes through it.
+    HANDLE fh = CreateFileA(hot_path.c_str(), GENERIC_READ | GENERIC_WRITE,
+            FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (fh == INVALID_HANDLE_VALUE) {
+        LLAMA_LOG_WARN("%s: cannot open %s read-write (%lu), hot file disabled\n",
+                __func__, hot_path.c_str(), GetLastError());
+        hot_index.clear();
+        return;
+    }
+    LARGE_INTEGER sz = {};
+    GetFileSizeEx(fh, &sz);
+    HANDLE mh = CreateFileMappingA(fh, nullptr, PAGE_READWRITE, 0, 0, nullptr);
+    if (mh == nullptr) {
+        CloseHandle(fh);
+        LLAMA_LOG_WARN("%s: CreateFileMapping failed (%lu), hot file disabled\n", __func__, GetLastError());
+        hot_index.clear();
+        return;
+    }
+    void * base = MapViewOfFile(mh, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, 0);
+    if (base == nullptr) {
+        CloseHandle(mh);
+        CloseHandle(fh);
+        LLAMA_LOG_WARN("%s: MapViewOfFile failed (%lu), hot file disabled\n", __func__, GetLastError());
+        hot_index.clear();
+        return;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    // page it in before locking, in parallel - the lock itself will not do the I/O for us
+    {
+        const size_t total = (size_t) sz.QuadPart;
+        const int32_t nthr = std::max(1, n_io_threads);
+        std::atomic<size_t> next{0};
+        const size_t CHUNK = 64ull << 20;
+        std::vector<std::thread> ts;
+        std::atomic<uint64_t> sink{0};
+        for (int32_t t = 0; t < nthr; t++) {
+            ts.emplace_back([&]() {
+                uint64_t acc = 0;
+                for (;;) {
+                    const size_t o = next.fetch_add(CHUNK);
+                    if (o >= total) {
+                        break;
+                    }
+                    const size_t end = std::min(total, o + CHUNK);
+                    for (size_t q = o; q < end; q += 4096) {
+                        acc += ((const volatile uint8_t *) base)[q];
+                    }
+                }
+                sink += acc;
+            });
+        }
+        for (auto & th : ts) {
+            th.join();
+        }
+    }
+    const double t_touch = (ggml_time_us() - t0)/1e6;
+
+    const int64_t t1 = ggml_time_us();
+    if (!host_lock(base, (size_t) sz.QuadPart)) {
+        UnmapViewOfFile(base);
+        CloseHandle(mh);
+        CloseHandle(fh);
+        LLAMA_LOG_WARN("%s: could not page-lock %.2f GiB, hot file disabled\n",
+                __func__, sz.QuadPart/1073741824.0);
+        hot_index.clear();
+        return;
+    }
+    hot_base   = base;
+    hot_size   = (size_t) sz.QuadPart;
+    hot_file   = fh;
+    hot_map    = mh;
+    hot_locked = true;
+    LLAMA_LOG_INFO("%s: hot expert file %.2f GiB, %zu experts, paged in %.1fs, locked in %.1fs\n",
+            __func__, hot_size/1073741824.0, hot_index.size(), t_touch, (ggml_time_us() - t1)/1e6);
+#else
+    LLAMA_LOG_WARN("%s: hot expert file is Windows-only for now\n", __func__);
+#endif
+}
+
+void llama_moe_stream::close_hot_file() {
+#ifdef _WIN32
+    if (hot_locked && host_unlock != nullptr && hot_base != nullptr) {
+        host_unlock(hot_base);
+    }
+    if (hot_base != nullptr) {
+        UnmapViewOfFile(hot_base);
+    }
+    if (hot_map != nullptr) {
+        CloseHandle((HANDLE) hot_map);
+    }
+    if (hot_file != nullptr) {
+        CloseHandle((HANDLE) hot_file);
+    }
+#endif
+    hot_base = nullptr;
+    hot_map  = nullptr;
+    hot_file = nullptr;
+    hot_locked = false;
+    hot_index.clear();
+}
+
+void llama_moe_stream::worker_loop(int32_t wid) {
+#ifdef _WIN32
+    // These threads are almost always blocked on I/O; what matters is how fast they are
+    // scheduled once a read completes. They share 6 cores with the ggml compute threads,
+    // and every layer waits on the slowest of them.
+    {
+        const char * e = std::getenv("LLAMA_MOE_STREAM_PRIO");
+        if (e == nullptr || atoi(e) != 0) {
+            SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+        }
+    }
+#endif
+    // page-aligned staging (Metal private buffers require page-aligned source + page-multiple
+    // length; O_DIRECT needs the extra head/tail slack for its aligned reads)
+    moe_l2().init(slab_sizes(), l2_pin ? pinned_buft() : nullptr);
+
+    // ggml_backend_tensor_set from plain host memory makes CUDA stage the copy through its own
+    // pinned buffer, which about halves the achieved PCIe rate; take the staging from the device
+    // host buffer type instead so the upload is a direct DMA
+    const size_t staging_size = max_nb_expert + 2*MOE_STREAM_DIRECT_ALIGN;
+
+    ggml_backend_buffer_t staging_buf = nullptr;
+    uint8_t *             staging     = nullptr;
+    if (use_pinned_staging) {
+        if (auto * host_buft = pinned_buft()) {
+            staging_buf = ggml_backend_buft_alloc_buffer(host_buft, staging_size);
+            if (staging_buf != nullptr) {
+                staging = (uint8_t *) ggml_backend_buffer_get_base(staging_buf);
+                if (((uintptr_t) staging) % MOE_STREAM_DIRECT_ALIGN != 0) {
+                    staging = nullptr; // unbuffered reads need a sector-aligned destination
+                }
+            }
+        }
+    }
+    if (staging == nullptr) {
+        if (staging_buf != nullptr) {
+            ggml_backend_buffer_free(staging_buf);
+            staging_buf = nullptr;
+        }
+        staging = (uint8_t *) moe_aligned_alloc(staging_size);
+    }
+    GGML_ASSERT(staging != nullptr);
+
+    std::unique_lock<std::mutex> lk(mtx);
+    while (true) {
+        cv_work.wait(lk, [&]{ return shutting_down || !q_demand.empty(); });
+        if (shutting_down) {
+            break;
+        }
+
+        llama_moe_stream_work w = q_demand.front();
+        q_demand.pop_front();
+
+        auto & sl   = *w.sl;
+        // widx < 0 means this one item carries every weight of the expert
+        const int32_t  w0  = w.widx < 0 ? 0 : w.widx;
+        const int32_t  w1  = w.widx < 0 ? (int32_t) sl.weights.size() : w.widx + 1;
+        const uint32_t bit = w.widx < 0 ? sl.weights_mask() : 1u << w.widx;
+        if (w.gen != sl.slot_gen[w.slot] ||
+            sl.slot_state[w.slot] != LLAMA_MOE_STREAM_SLOT_LOADING ||
+            sl.slot_expert[w.slot] != w.expert ||
+            (sl.slot_claimed[w.slot] & bit) != 0 ||
+            (sl.slot_done[w.slot] & bit) != 0) {
+            continue; // stale, already loaded, or owned by another worker
+        }
+        sl.slot_claimed[w.slot] |= bit;
+
+        lk.unlock();
+
+        const bool use_uploader = h2d_async != nullptr && staging_base != nullptr;
+        uint32_t issued = 0; // weights handed to the uploader; it commits those
+        bool    ok      = true;
+        int     n_buf   = 0, n_nobuf = 0;
+        int     n_f = 0, n_m = 0, n_s = 0;
+        int64_t us_read = 0, us_up   = 0;
+        for (int32_t wi = w0; wi < w1 && ok; wi++) {
+            const auto & wt = sl.weights[wi];
+            const int64_t  t_r0  = ggml_time_us();
+            const size_t   eoffs = wt.offs + (size_t) w.expert*wt.nb_expert;
+            const uint64_t l2key = moe_l2_key(wt.file_idx, eoffs);
+            const uint8_t * data = nullptr;
+
+            // the arena entry doubles as the staging buffer, so an L2 hit costs one DMA and an
+            // L2 miss costs one read plus that DMA - neither pays for an extra copy. the mapped
+            // upload never fills an entry, so the two are exclusive.
+            const bool use_map = !map_addr.empty() && map_addr[wt.file_idx] != nullptr;
+
+            moe_l2_cache::ref_t l2r = use_map ? moe_l2_cache::ref_t{} : moe_l2().acquire(l2key, wt.nb_expert);
+
+            // The arena is too large to stay fully resident, so a DMA straight out of it can fault
+            // inside the CUDA copy. Keep the upload on the pinned staging buffer and pay one
+            // memcpy either way: out of the arena on a hit, into it on a fill.
+            const bool l2_dma = l2r.ptr != nullptr && (l2_direct || moe_l2().is_pinned());
+
+            // With the uploader running, read into a slab of the shared pinned pool instead of
+            // this worker's own staging buffer: ownership passes to the uploader, so the worker
+            // is free to start the next read immediately.
+            const uint8_t * hot = hot_lookup(wt.file_idx, eoffs, wt.nb_expert);
+            int32_t   pool_buf = -1;
+            uint8_t * slab     = staging;
+            if (use_uploader && hot == nullptr && !use_map && l2r.ptr == nullptr) {
+                std::unique_lock<std::mutex> lg(mtx);
+                cv_upload.wait(lg, [&]{ return shutting_down || !staging_free.empty(); });
+                if (!shutting_down) {
+                    pool_buf = staging_free.back();
+                    staging_free.pop_back();
+                    slab = staging_base + (size_t) pool_buf*staging_stride;
+                }
+            }
+            uint8_t * dst = l2_dma ? l2r.ptr : slab;
+
+            if (hot != nullptr) {
+                // locked, already resident, and registered with CUDA: hand the pointer
+                // straight to the copy. No read, no staging memcpy, one pass over DRAM.
+                data = hot;
+            } else if (use_map) {
+                data = map_addr[wt.file_idx] + eoffs;
+            } else if (l2r.ptr != nullptr && !l2r.fill) {
+                if (l2_dma) {
+                    data = l2r.ptr;
+                } else {
+                    memcpy(slab, l2r.ptr, wt.nb_expert);
+                    data = slab;
+                }
+            } else {
+                const bool in_band = w.heat >= admit_lo && w.heat <= admit_hi;
+#ifdef _WIN32
+                // unbuffered needs head/tail slack that an arena entry does not have
+                void * h_nb = in_band || h_nobuf.empty() || dst != slab
+                    ? nullptr : h_nobuf[one_handle ? 0 : wid][wt.file_idx];
+                if (h_nb != nullptr) {
+                    data = llama_moe_stream_pread_nb(h_nb, slab, wt.nb_expert, eoffs);
+                    n_nobuf++;
+                } else if (!h_rand.empty() && !serial_io) {
+                    data = llama_moe_stream_win_pread(h_rand[one_handle ? 0 : wid][wt.file_idx], dst, wt.nb_expert, eoffs) ? dst : nullptr;
+                    n_buf++;
+                } else {
+                    data = llama_moe_stream_pread(*files[wt.file_idx], dst, wt.nb_expert, eoffs, use_direct_io, serial_io);
+                    n_buf++;
+                }
+#else
+                GGML_UNUSED(in_band);
+                data = llama_moe_stream_pread(*files[wt.file_idx], dst, wt.nb_expert, eoffs, use_direct_io, serial_io);
+                n_buf++;
+#endif
+            }
+            const int64_t t_r1 = ggml_time_us();
+            const int64_t dt   = t_r1 - t_r0;
+            us_read += dt;
+            if (dt < 150) {
+                n_f++;
+            } else if (dt < 600) {
+                n_m++;
+            } else {
+                n_s++;
+            }
+            if (data != nullptr && l2r.fill && !l2_dma) {
+                memcpy(l2r.ptr, data, wt.nb_expert); // populate the tier from what we just read
+            }
+            if (data != nullptr) {
+                if (hot != nullptr && use_uploader) {
+                    // the hot file is page-locked and never written, so the uploader can DMA
+                    // from it whenever it gets to it - no staging slab is tied up meanwhile
+                    std::lock_guard<std::mutex> lg(mtx);
+                    q_upload.push_back({ &sl, w.slot, wi, w.gen, -1, hot });
+                    issued |= 1u << wi;
+                    cv_upload.notify_one();
+                } else if (pool_buf >= 0) {
+                    // hand the slab to the uploader and move on to the next read; the copy
+                    // crosses PCIe while this worker is already reading the next slab
+                    std::lock_guard<std::mutex> lg(mtx);
+                    q_upload.push_back({ &sl, w.slot, wi, w.gen, pool_buf, nullptr });
+                    issued |= 1u << wi;
+                    pool_buf = -1;
+                    cv_upload.notify_one();
+                } else {
+                    ggml_backend_tensor_set(wt.cache, data, (size_t) w.slot*wt.nb_expert, wt.nb_expert);
+                }
+            }
+            if (pool_buf >= 0) {
+                std::lock_guard<std::mutex> lg(mtx);
+                staging_free.push_back(pool_buf); // read failed, give the slab back
+                pool_buf = -1;
+                cv_upload.notify_all();
+            }
+            moe_l2().release(l2r, data != nullptr);
+            us_up += ggml_time_us() - t_r1;
+            ok = data != nullptr;
+        }
+
+        lk.lock();
+
+        stats.n_fast       += n_f;
+        stats.n_med        += n_m;
+        stats.n_slow       += n_s;
+        stats.n_buffered   += n_buf;
+        stats.n_unbuffered += n_nobuf;
+        stats.t_read_us    += us_read;
+        stats.t_upload_us  += us_up;
+
+        // weights handed to the uploader stay claimed until it has synchronized the copy
+        sl.slot_claimed[w.slot] &= ~(bit & ~issued);
+        if (!ok) {
+            load_failed = true;
+            cv_done.notify_all();
+        } else {
+            sl.slot_done[w.slot] |= bit & ~issued;
+            // the remap only ever waits on RESIDENT, so a part-loaded slot is nothing to wake for
+            if (sl.slot_done[w.slot] == sl.weights_mask()) {
+                sl.slot_state[w.slot] = LLAMA_MOE_STREAM_SLOT_RESIDENT;
+                cv_done.notify_all();
+            }
+        }
+    }
+    lk.unlock();
+
+    if (staging_buf != nullptr) {
+        ggml_backend_buffer_free(staging_buf);
+    } else {
+        moe_aligned_free(staging);
+    }
+}
+
+// Ranked expert ids per layer. Text so it can be inspected and hand-edited; it is tiny
+// (a few hundred KiB) and written once at shutdown.
+void llama_moe_stream::save_heat() const {
+    if (heat_path.empty()) {
+        return;
+    }
+    // write-then-rename: a kill partway through a save must not leave a truncated ranking
+    const std::string tmp = heat_path + ".tmp";
+    FILE * f = fopen(tmp.c_str(), "w");
+    if (f == nullptr) {
+        LLAMA_LOG_WARN("%s: cannot write expert heat to %s\n", __func__, tmp.c_str());
+        return;
+    }
+    fprintf(f, "moe_heat 2\n");
+
+    std::vector<int32_t> order;
+    for (size_t il = 0; il < layers.size(); il++) {
+        const auto & sl = layers[il];
+        if (!sl) {
+            continue;
+        }
+        order.resize(sl->n_expert);
+        for (uint32_t e = 0; e < sl->n_expert; e++) {
+            order[e] = (int32_t) e;
+        }
+        // ranked by the undecayed count: the warm order should be "most used", not "most
+        // recently used", and the decayed value drops rare-but-real experts to 0, which is
+        // what capped how deep a page-cache warm could go.
+        std::sort(order.begin(), order.end(), [&](int32_t a, int32_t b) {
+            if (sl->route_total[a] != sl->route_total[b]) {
+                return sl->route_total[a] > sl->route_total[b];
+            }
+            return sl->route_hotness[a] > sl->route_hotness[b];
+        });
+
+        size_t n = 0;
+        while (n < order.size() && sl->route_total[order[n]] > 0) {
+            n++;
+        }
+        fprintf(f, "L %zu %zu\n", il, n);
+        for (size_t i = 0; i < n; i++) {
+            fprintf(f, "%d %u %u\n", order[i], sl->route_hotness[order[i]], sl->route_total[order[i]]);
+        }
+    }
+    fclose(f);
+
+    std::remove(heat_path.c_str()); // rename does not replace on Windows
+    if (std::rename(tmp.c_str(), heat_path.c_str()) != 0) {
+        LLAMA_LOG_WARN("%s: cannot move %s into place\n", __func__, tmp.c_str());
+        return;
+    }
+    if (debug) {
+        fprintf(stderr, "moe stream: wrote expert heat to %s\n", heat_path.c_str());
+        fflush(stderr);
+    }
+}
+
+// Fill every device slot with the hottest experts from a previous run, then optionally read
+// further down the ranking so those slabs land in the OS page cache too.
+void llama_moe_stream::warm_from_heat() {
+    FILE * f = fopen(heat_path.c_str(), "r");
+    if (f == nullptr) {
+        if (debug) {
+            fprintf(stderr, "moe stream: no heat file at %s, starting cold\n", heat_path.c_str());
+            fflush(stderr);
+        }
+        return;
+    }
+
+    char magic[32] = {};
+    int  version   = 0;
+    if (fscanf(f, "%31s %d", magic, &version) != 2 || strcmp(magic, "moe_heat") != 0 ||
+            (version != 1 && version != 2)) {
+        LLAMA_LOG_WARN("%s: %s is not a v1/v2 heat file\n", __func__, heat_path.c_str());
+        fclose(f);
+        return;
+    }
+
+    struct heat_entry { int32_t e; uint32_t h; uint32_t tot; };
+    std::vector<std::vector<heat_entry>> ranked(layers.size());
+    size_t il = 0, n = 0;
+    while (fscanf(f, " L %zu %zu", &il, &n) == 2) {
+        if (il >= layers.size()) {
+            break;
+        }
+        ranked[il].reserve(n);
+        for (size_t i = 0; i < n; i++) {
+            int32_t  e = -1;
+            uint32_t h = 0, tot = 0;
+            if (fscanf(f, " %d %u", &e, &h) != 2) {
+                break;
+            }
+            if (version >= 2 && fscanf(f, " %u", &tot) != 1) {
+                break;
+            }
+            // seed eviction with something non-zero even where the decayed heat aged
+            // out, or the warm set is evicted again within ~30 tokens
+            if (h == 0 && tot > 0) {
+                h = 1;
+            }
+            if (e >= 0) {
+                ranked[il].push_back({ e, h, tot > 0 ? tot : h });
+            }
+        }
+    }
+    fclose(f);
+
+    const int64_t t0 = ggml_time_us();
+    size_t n_slots_filled = 0;
+    {
+        std::unique_lock<std::mutex> lk(mtx);
+        start_workers_locked();
+        for (size_t i = 0; i < layers.size(); i++) {
+            auto & sl = layers[i];
+            if (!sl || ranked[i].empty()) {
+                continue;
+            }
+            // eviction ranks by route_hotness first, so a cache warmed without it would be
+            // thrown away by the first few misses
+            for (const auto & r : ranked[i]) {
+                if ((uint32_t) r.e < sl->n_expert) {
+                    sl->route_hotness[r.e] = r.h;
+                    // also the undecayed count, so the page-cache admission band treats a
+                    // warmed expert as known rather than as a first-ever touch
+                    sl->route_total[r.e] = r.tot;
+                }
+            }
+
+            const size_t want = std::min<size_t>(ranked[i].size(), sl->n_slots);
+            for (size_t k = want; k-- > 0; ) {
+                const int32_t e = ranked[i][k].e;
+                if ((uint32_t) e >= sl->n_expert || sl->expert_slot.count(e)) {
+                    continue;
+                }
+                const int32_t slot = (int32_t) k;
+                reserve_slot_locked(*sl, e, slot);
+                enqueue_weights_locked(*sl, e, slot);
+                n_slots_filled++;
+            }
+        }
+        // the graph has not run yet, so nothing can be evicted out from under us
+        cv_done.wait(lk, [&]{
+            if (load_failed) {
+                return true;
+            }
+            for (const auto & sl : layers) {
+                if (!sl) {
+                    continue;
+                }
+                for (uint32_t s = 0; s < sl->n_slots; s++) {
+                    if (sl->slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+                        return false;
+                    }
+                }
+            }
+            return true;
+        });
+    }
+
+    // Beyond the device cache, read further down each ranking with ordinary buffered reads so
+    // the slabs end up on the standby list. This is what the demand misses would otherwise
+    // spend hundreds of tokens doing.
+    // Warming is itself an I/O job, so it uses the same per-worker handles as the loader:
+    // on one shared handle this loop ran at ~1 GB/s and a 16 GiB warm was unaffordable.
+    std::atomic<size_t> warmed_a{0};
+    const size_t budget = (size_t) (warm_extra_gb * 1024.0*1024.0*1024.0);
+    if (budget > 0) {
+        struct warm_item { uint16_t file_idx; size_t offs; size_t len; };
+        std::vector<warm_item> items;
+        size_t planned = 0;
+        for (size_t k = 0; planned < budget; k++) {
+            bool any = false;
+            for (size_t i2 = 0; i2 < layers.size() && planned < budget; i2++) {
+                auto & sl = layers[i2];
+                if (!sl) {
+                    continue;
+                }
+                const size_t idx = sl->n_slots + k;
+                if (idx >= ranked[i2].size()) {
+                    continue;
+                }
+                any = true;
+                const int32_t e = ranked[i2][idx].e;
+                for (const auto & wt : sl->weights) {
+                    items.push_back({ wt.file_idx, wt.offs + (size_t) e*wt.nb_expert, wt.nb_expert });
+                    planned += wt.nb_expert;
+                }
+            }
+            if (!any) {
+                break;
+            }
+        }
+
+        // Warm coldest-first. The page cache holds less than the full ranking, so reading
+        // hottest-first means the hottest slabs are the ones the rest of the warm evicts -
+        // the warm would end up holding exactly the wrong half of what it read.
+        std::reverse(items.begin(), items.end());
+
+        const int32_t nthr = std::max(1, n_io_threads);
+        std::atomic<size_t> next{0};
+        std::vector<std::thread> ts;
+        for (int32_t t = 0; t < nthr; t++) {
+            ts.emplace_back([&, t]() {
+                uint8_t * buf = (uint8_t *) moe_aligned_alloc(max_nb_expert + 2*MOE_STREAM_DIRECT_ALIGN);
+                if (buf == nullptr) {
+                    return;
+                }
+                for (;;) {
+                    const size_t k = next.fetch_add(1);
+                    if (k >= items.size()) {
+                        break;
+                    }
+                    const auto & it = items[k];
+                    bool ok = false;
+#ifdef _WIN32
+                    if (!h_rand.empty()) {
+                        ok = llama_moe_stream_win_pread(h_rand[t % (int32_t) h_rand.size()][it.file_idx],
+                                                        buf, it.len, it.offs);
+                    } else
+#endif
+                    {
+                        ok = llama_moe_stream_pread(*files[it.file_idx], buf, it.len, it.offs, false) != nullptr;
+                    }
+                    if (ok) {
+                        warmed_a.fetch_add(it.len, std::memory_order_relaxed);
+                    }
+                }
+                moe_aligned_free(buf);
+            });
+        }
+        for (auto & th : ts) {
+            th.join();
+        }
+    }
+    const size_t warmed = warmed_a.load();
+
+    if (debug) {
+        fprintf(stderr, "moe stream: warmed %zu device slots + %.2f GiB into the page cache in %.1f s\n",
+                n_slots_filled, (double) warmed/(1024.0*1024.0*1024.0),
+                (ggml_time_us() - t0)/1e6);
+        fflush(stderr);
+    }
+}
+
+// one queue item per weight of the expert, so they load concurrently
+void llama_moe_stream::enqueue_weights_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot) {
+    const int32_t n = split_weights ? (int32_t) sl.weights.size() : 1;
+    for (int32_t i = 0; i < n; i++) {
+        // the admission band keys on the UNDECAYED count: a warmed expert whose decayed
+        // hotness has aged out is still in the page cache, and reading it unbuffered would
+        // go to disk for bytes that are already in RAM
+        q_demand.push_back({ &sl, expert, slot, split_weights ? i : -1, sl.slot_gen[slot], sl.route_total[expert] });
+        cv_work.notify_one();
+    }
+}
+
+// least valuable evictable slot: empty first, then coldest resident (min route hotness, oldest use
+// as tiebreak); LOADING and keep slots are never candidates. returns -1 when no candidate exists
+int32_t llama_moe_stream::pick_victim_locked(llama_moe_stream_layer & sl, const uint8_t * keep) const {
+    int32_t v = -1;
+
+    for (uint32_t s = 0; s < sl.n_slots; s++) {
+        if ((keep && keep[s]) || sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+            continue;
+        }
+        if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_EMPTY) {
+            return s;
+        }
+        if (v < 0) {
+            v = s;
+            continue;
+        }
+        const uint32_t hs = sl.route_hotness[sl.slot_expert[s]];
+        const uint32_t hv = sl.route_hotness[sl.slot_expert[v]];
+        if (hs < hv || (hs == hv && sl.slot_last_use[s] < sl.slot_last_use[v])) {
+            v = s;
+        }
+    }
+
+    return v;
+}
+
+// bind expert -> slot and mark it LOADING: evict the slot's prior occupant, bump slot_gen (so any
+// in-flight load for the old occupant is recognized as stale), and update the expert_slot index
+void llama_moe_stream::reserve_slot_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot) {
+    if (sl.slot_expert[slot] >= 0) {
+        if (debug) {
+            LLAMA_LOG_DEBUG("%s: layer %d: evict expert %d from slot %d\n", __func__, sl.il, sl.slot_expert[slot], slot);
+        }
+        sl.expert_slot.erase(sl.slot_expert[slot]);
+    }
+
+    sl.slot_expert[slot]  = expert;
+    sl.slot_state[slot]   = LLAMA_MOE_STREAM_SLOT_LOADING;
+    sl.slot_done[slot]    = 0;
+    sl.slot_claimed[slot] = 0;
+    sl.slot_gen[slot]++;
+    sl.slot_last_use[slot] = ++sl.use_counter;
+    sl.expert_slot[expert] = slot;
+    sl.seen[expert] = 1;
+}
+
+// windowed counters since the last line, so a warming run and a steady-state run are told apart
+void llama_moe_stream::print_stats_delta() {
+    const int64_t calls = stats.n_calls - dbg_last_call;
+    if (dbg_every <= 0 || calls < dbg_every) {
+        return;
+    }
+    dbg_last_call = stats.n_calls;
+
+    const int64_t hit   = stats.n_hit       - dbg_prev.hit;
+    const int64_t miss  = stats.n_miss      - dbg_prev.miss;
+    const int64_t cold  = stats.n_miss_cold - dbg_prev.cold;
+    const int64_t stall = stats.t_stall_us  - dbg_prev.stall;
+    const int64_t nobuf = stats.n_unbuffered- dbg_prev.nobuf;
+    GGML_UNUSED(nobuf);
+    const int64_t rd    = stats.t_read_us   - dbg_prev.read;
+    const int64_t up    = stats.t_upload_us - dbg_prev.up;
+    const int64_t fast  = stats.n_fast      - dbg_prev.fast;
+    const int64_t med   = stats.n_med       - dbg_prev.med;
+    const int64_t slow  = stats.n_slow      - dbg_prev.slow;
+    const int64_t rmp   = stats.t_remap_us  - dbg_prev.remap;
+    dbg_prev = { stats.n_hit, stats.n_miss, stats.n_miss_cold, stats.t_stall_us,
+                 stats.n_buffered, stats.n_unbuffered, stats.t_read_us, stats.t_upload_us,
+                 stats.n_fast, stats.n_med, stats.n_slow, stats.t_remap_us };
+
+    const int64_t tok = calls/(int64_t) std::max<size_t>(1, std::count_if(layers.begin(), layers.end(),
+                [](const std::unique_ptr<llama_moe_stream_layer> & l) { return l != nullptr; }));
+
+    // the library log callback does not reach llama-server's log file, so write to stderr
+    fprintf(stderr, "moe stream: %4" PRId64 " tok | L1 hit %5.1f%% | miss %5.1f/tok (%4" PRId64 " cold)"
+                    " | remap %6.1f | stall %6.1f | read %6.1f | up %6.1f ms/tok | src %5.1f/%5.1f/%5.1f f/m/s\n",
+            tok, 100.0*(double) hit/(double) std::max<int64_t>(1, hit+miss),
+            (double) miss/(double) std::max<int64_t>(1, tok), cold,
+            rmp   /1000.0/(double) std::max<int64_t>(1, tok),
+            stall /1000.0/(double) std::max<int64_t>(1, tok),
+            rd    /1000.0/(double) std::max<int64_t>(1, tok),
+            up    /1000.0/(double) std::max<int64_t>(1, tok),
+            (double) fast/(double) std::max<int64_t>(1, tok),
+            (double) med /(double) std::max<int64_t>(1, tok),
+            (double) slow/(double) std::max<int64_t>(1, tok));
+    if (moe_l2().arena != nullptr) {
+        const uint64_t h2 = moe_l2().hits, m2 = moe_l2().misses;
+        fprintf(stderr, "moe stream: L2 hit %5.1f%% (%llu / %llu lifetime)\n",
+                100.0*(double) h2/(double) std::max<uint64_t>(1, h2+m2),
+                (unsigned long long) h2, (unsigned long long)(h2+m2));
+    }
+    fflush(stderr);
+}
+
+// A streamed slab can be uploaded straight from the mapped file, which skips the kernel copy a
+// buffered read makes into staging. The offsets come from the loader, so compare one slab read
+// both ways before trusting them - a wrong mapping would quietly upload wrong weights.
+void llama_moe_stream::set_mappings(const llama_mmaps & mappings) {
+#ifndef _WIN32
+    // only Windows keeps the whole view mapped; elsewhere the loader really unmaps the fragments
+    // it did not load, and the streamed experts are among them
+    GGML_UNUSED(mappings);
+    return;
+#else
+    if (!use_mmap_copy || mappings.empty() || use_direct_io) {
+        return;
+    }
+
+    map_addr.assign(files.size(), nullptr);
+    map_size.assign(files.size(), 0);
+    for (size_t i = 0; i < files.size() && i < mappings.size(); i++) {
+        if (mappings[i]) {
+            map_addr[i] = (const uint8_t *) mappings[i]->addr();
+            map_size[i] = mappings[i]->size();
+        }
+    }
+
+    const llama_moe_stream_weight * probe = nullptr;
+    for (const auto & sl : layers) {
+        if (sl && !sl->weights.empty()) {
+            probe = &sl->weights.front();
+            break;
+        }
+    }
+
+    bool ok = probe != nullptr && probe->file_idx < map_addr.size() && map_addr[probe->file_idx] != nullptr;
+    if (ok) {
+        const size_t len = std::min<size_t>(probe->nb_expert, 64*1024);
+        ok = probe->offs + len <= map_size[probe->file_idx];
+        if (ok) {
+            uint8_t * tmp = (uint8_t *) moe_aligned_alloc(len + 2*MOE_STREAM_DIRECT_ALIGN);
+            GGML_ASSERT(tmp != nullptr);
+            const uint8_t * via_read = llama_moe_stream_pread(*files[probe->file_idx], tmp, len, probe->offs, false);
+            ok = via_read != nullptr && memcmp(via_read, map_addr[probe->file_idx] + probe->offs, len) == 0;
+            moe_aligned_free(tmp);
+        }
+    }
+
+    if (!ok) {
+        LLAMA_LOG_WARN("%s: mapped slab does not match a read, uploading from staging instead\n", __func__);
+        map_addr.clear();
+        map_size.clear();
+    }
+
+    if (debug) {
+        fprintf(stderr, "moe stream: mmap upload %s\n", map_addr.empty() ? "off" : "on");
+        fflush(stderr);
+    }
+#endif
+}
+
+std::vector<size_t> llama_moe_stream::slab_sizes() const {
+    std::vector<size_t> out;
+    for (const auto & sl : layers) {
+        if (!sl) {
+            continue;
+        }
+        for (const auto & wt : sl->weights) {
+            if (std::find(out.begin(), out.end(), wt.nb_expert) == out.end()) {
+                out.push_back(wt.nb_expert);
+            }
+        }
+        break; // every streamed layer has the same weight shapes
+    }
+    return out;
+}
+
+ggml_backend_buffer_type_t llama_moe_stream::pinned_buft() const {
+    for (const auto & [buft, ctx] : ctxs) {
+        ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+        if (dev == nullptr) {
+            continue;
+        }
+        if (auto * hb = ggml_backend_dev_host_buffer_type(dev)) {
+            return hb;
+        }
+    }
+    return nullptr;
+}
+
+size_t llama_moe_stream::size_bufs() const {
+    size_t size = 0;
+    for (const auto & buf : bufs) {
+        size += ggml_backend_buffer_get_size(buf.get());
+    }
+    return size;
+}
+
+void llama_moe_stream::print_stats() const {
+    std::lock_guard<std::mutex> lock(mtx);
+
+    const int64_t n_touched = stats.n_hit + stats.n_miss;
+    LLAMA_LOG_INFO("%s: moe stream: remap calls = %" PRId64 ", expert hits = %" PRId64 ", misses = %" PRId64 " (%" PRId64 " cold), hit rate = %.2f%%\n",
+            __func__, stats.n_calls, stats.n_hit, stats.n_miss, stats.n_miss_cold,
+            n_touched > 0 ? 100.0*stats.n_hit/n_touched : 0.0);
+    LLAMA_LOG_INFO("%s: moe stream: load stall = %.2f ms total (%.3f ms per remap call)\n",
+            __func__, stats.t_stall_us/1000.0, stats.n_calls > 0 ? stats.t_stall_us/1000.0/stats.n_calls : 0.0);
+    if (stats.n_wave_calls > 0) {
+        LLAMA_LOG_INFO("%s: moe stream: waves = %" PRId64 " (%" PRId64 " non-empty), preloads issued = %" PRId64 " (ready on arrival = %" PRId64 "), wave stall = %.2f ms\n",
+                __func__, stats.n_wave_calls, stats.n_waves_run, stats.n_preload_issued, stats.n_preload_ready, stats.t_stall_wave_us/1000.0);
+    }
+}
+
+// custom-op callback (single-threaded on ith 0): given the router's expert ids, ensure every touched
+// expert is resident - reserving cache slots and demand-loading misses, stalling until they commit -
+// then rewrite each id to its cache slot. this only relabels ids, so the same experts are computed
+// in the same order; the result matches a non-streamed run (bit-exact when both paths use the same
+// kernels, as on CUDA; a CPU build that repacks the non-streamed weights can differ in the last bits).
+void llama_moe_stream_remap(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    auto * sl  = (llama_moe_stream_layer *) userdata;
+    auto * mgr = sl->mgr;
+
+    const int64_t t_remap0 = ggml_time_us();
+
+    GGML_ASSERT(a->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_are_same_shape(a, dst));
+
+    const int64_t n = ggml_nelements(a);
+
+    const int32_t * ids = (const int32_t *) a->data;
+          int32_t * out = (int32_t *) dst->data;
+
+    std::unique_lock<std::mutex> lk(mgr->mtx);
+
+    if (mgr->load_failed) {
+        GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+    }
+
+    mgr->stats.n_calls++;
+    mgr->start_workers_locked();
+
+    // distinct experts touched by this ubatch, in first-use order
+    sl->touched.assign(sl->n_expert, 0);
+    sl->uniq.clear();
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t e = ids[i];
+        GGML_ASSERT(e >= 0 && (uint32_t) e < sl->n_expert);
+        if (!sl->touched[e]) {
+            sl->touched[e] = 1;
+            sl->uniq.push_back(e);
+        }
+    }
+
+    if (sl->uniq.size() > sl->n_slots) {
+        GGML_ABORT("MoE expert streaming: layer %d needs %zu distinct experts but the cache has only %u slots; "
+                   "increase --moe-stream-cache or reduce the ubatch size (-ub)",
+                sl->il, sl->uniq.size(), sl->n_slots);
+    }
+
+    if (mgr->trace != nullptr) {
+        const int32_t hdr[2] = { sl->il, (int32_t) sl->uniq.size() };
+        fwrite(hdr, sizeof(int32_t), 2, mgr->trace);
+        fwrite(sl->uniq.data(), sizeof(int32_t), sl->uniq.size(), mgr->trace);
+    }
+
+    // route hotness for eviction; halved periodically so a formerly-hot expert ages out
+    for (const int32_t e : sl->uniq) {
+        sat_inc(sl->route_hotness[e]);
+        sat_inc(sl->route_total[e]);
+    }
+    if (mgr->hot_decay_interval > 0 && mgr->stats.n_calls % mgr->hot_decay_interval == 0) {
+        for (auto & sl2 : mgr->layers) {
+            if (sl2) {
+                for (auto & h : sl2->route_hotness) {
+                    h >>= 1;
+                }
+            }
+        }
+    }
+
+    // Ask the OS for every slab this call will miss on, in one batched call, before any worker
+    // starts uploading. The upload reads the mapped file, so a slab still on disk would otherwise
+    // be faulted in page by page while a worker blocks on it; one PrefetchVirtualMemory turns that
+    // into concurrent large reads. Residency can change while the lock is dropped - this only
+    // changes when the I/O starts, never which experts get computed.
+    if (!mgr->map_addr.empty()) {
+        mgr->pf_ranges.clear();
+        for (const int32_t e : sl->uniq) {
+            if (sl->expert_slot.find(e) != sl->expert_slot.end()) {
+                continue;
+            }
+            for (const auto & wt : sl->weights) {
+                const uint8_t * base = mgr->map_addr[wt.file_idx];
+                if (base != nullptr) {
+                    mgr->pf_ranges.push_back({ (void *) (base + wt.offs + (size_t) e*wt.nb_expert), wt.nb_expert });
+                }
+            }
+        }
+        if (!mgr->pf_ranges.empty()) {
+            lk.unlock();
+            llama_prefetch(mgr->pf_ranges);
+            lk.lock();
+        }
+    }
+
+    // MEASUREMENT ONLY. Maps every requested expert onto whatever is already in slot i and
+    // never loads anything, so a run measures the graph and GPU time with the expert stall
+    // removed. The output is garbage by construction - this exists to size the floor that no
+    // amount of I/O work can get under. LLAMA_MOE_STREAM_NOWAIT=1.
+    static const bool nowait = std::getenv("LLAMA_MOE_STREAM_NOWAIT") != nullptr;
+    if (nowait) {
+        for (int64_t i = 0; i < n; i++) {
+            out[i] = (int32_t) (ids[i] % (int32_t) sl->n_slots);
+        }
+        mgr->stats.t_remap_us += ggml_time_us() - t_remap0;
+        return;
+    }
+
+    // classify the touched experts; reserve and enqueue demand loads in deterministic order
+    std::fill(sl->keep.begin(), sl->keep.end(), 0);
+    sl->demand_slots.clear();
+
+    bool waited = false;
+    for (const int32_t e : sl->uniq) {
+        const auto it = sl->expert_slot.find(e);
+        if (it != sl->expert_slot.end()) {
+            const int32_t s = it->second;
+            if (sl->slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+                mgr->enqueue_weights_locked(*sl, e, s);
+                waited = true;
+            }
+            mgr->stats.n_hit++;
+            sl->keep[s] = 1;
+            sl->demand_slots.push_back(s);
+        } else {
+            int32_t v;
+            while ((v = mgr->pick_victim_locked(*sl, sl->keep.data())) < 0) {
+                // every allowed slot is loading; wait for a commit and retry
+                mgr->cv_done.wait(lk);
+                if (mgr->load_failed) {
+                    GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+                }
+            }
+            if (!sl->seen[e]) {
+                mgr->stats.n_miss_cold++;
+            }
+            mgr->reserve_slot_locked(*sl, e, v);
+            mgr->enqueue_weights_locked(*sl, e, v);
+            mgr->stats.n_miss++;
+            waited = true;
+            sl->keep[v] = 1;
+            sl->demand_slots.push_back(v);
+        }
+    }
+
+    if (waited) {
+        const int64_t t0 = ggml_time_us();
+        mgr->cv_done.wait(lk, [&]{
+            if (mgr->load_failed) {
+                return true;
+            }
+            for (const int32_t s : sl->demand_slots) {
+                if (sl->slot_state[s] != LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+                    return false;
+                }
+            }
+            return true;
+        });
+        if (mgr->load_failed) {
+            GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+        }
+        mgr->stats.t_stall_us += ggml_time_us() - t0;
+    }
+
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t s = sl->expert_slot.at(ids[i]);
+        sl->slot_last_use[s] = ++sl->use_counter;
+        out[i] = s;
+    }
+
+    mgr->stats.t_remap_us += ggml_time_us() - t_remap0;
+
+    if (mgr->heat_save_every > 0 && mgr->stats.n_calls - mgr->heat_last_save >= mgr->heat_save_every) {
+        mgr->heat_last_save = mgr->stats.n_calls;
+        mgr->save_heat();
+    }
+
+    mgr->print_stats_delta();
+}
+
+// stable per-wave userdata; grows lazily and records the per-wave expert capacity (set at build)
+llama_moe_stream_wave * llama_moe_stream_layer::wave_userdata(int32_t wave, uint32_t capacity) {
+    GGML_ASSERT(capacity >= 1 && capacity <= n_slots);
+    plan_capacity = capacity;
+    while ((size_t) wave >= wave_ud.size()) {
+        auto ud = std::make_unique<llama_moe_stream_wave>();
+        ud->sl   = this;
+        ud->wave = (int32_t) wave_ud.size();
+        wave_ud.push_back(std::move(ud));
+    }
+    return wave_ud[wave].get();
+}
+
+// wave 0 of a ubatch: record the distinct touched experts (sl.uniq, first-use order) and split them
+// into consecutive groups of plan_capacity, one group per wave (sl.expert_wave[e] = e's wave)
+void llama_moe_stream::plan_waves_locked(llama_moe_stream_layer & sl, const int32_t * ids, int64_t n) {
+    stats.n_calls++;
+    start_workers_locked();
+
+    sl.touched.assign(sl.n_expert, 0);
+    sl.uniq.clear();
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t e = ids[i];
+        GGML_ASSERT(e >= 0 && (uint32_t) e < sl.n_expert);
+        if (!sl.touched[e]) {
+            sl.touched[e] = 1;
+            sl.uniq.push_back(e);
+        }
+    }
+
+    GGML_ASSERT(sl.plan_capacity > 0);
+    sl.expert_wave.assign(sl.n_expert, 0xff);
+    for (size_t i = 0; i < sl.uniq.size(); i++) {
+        GGML_ASSERT(i/sl.plan_capacity < 0xff);
+        sl.expert_wave[sl.uniq[i]] = (uint8_t) (i/sl.plan_capacity);
+    }
+    sl.plan_n_waves   = (uint32_t) ((sl.uniq.size() + sl.plan_capacity - 1)/sl.plan_capacity);
+    sl.plan_next_wave = 0;
+}
+
+// make wave w's expert slice (uniq[w*cap .. +count)) resident, waiting for its loads, and best-effort
+// preload the next wave so its loads overlap this wave's compute. leaves sl.demand_slots = this wave's
+// slots and sl.plan_pool = the resident parking pool (>= n_ids slots) the emit draws masked pairs from
+void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids) {
+    const size_t first = (size_t) w*sl.plan_capacity;
+    const size_t count = first < sl.uniq.size() ? std::min<size_t>(sl.plan_capacity, sl.uniq.size() - first) : 0;
+
+    std::fill(sl.keep.begin(), sl.keep.end(), 0);
+    sl.demand_slots.clear();
+
+    // a small final wave has fewer than n_ids own slots; borrow the rest from the previous wave's
+    //   pool so every token row has n_ids distinct resident parking slots for its masked pairs
+    std::vector<int32_t> borrowed;
+    if (count < n_ids) {
+        GGML_ASSERT(sl.plan_pool.size() >= n_ids - count);
+        for (size_t i = 0; i < n_ids - count; i++) {
+            borrowed.push_back(sl.plan_pool[i]);
+            sl.keep[sl.plan_pool[i]] = 1; // parking slots must survive this wave's loads
+        }
+    }
+
+    // protect the next wave's already-resident experts so this wave's victims do not evict them
+    const size_t nfirst = first + sl.plan_capacity;
+    const size_t ncount = nfirst < sl.uniq.size() ? std::min<size_t>(sl.plan_capacity, sl.uniq.size() - nfirst) : 0;
+    for (size_t i = nfirst; i < nfirst + ncount; i++) {
+        const auto it = sl.expert_slot.find(sl.uniq[i]);
+        if (it != sl.expert_slot.end()) {
+            sl.keep[it->second] = 1;
+        }
+    }
+
+    // reserve and demand-load this wave's experts (per-expert, same path as the decode remap)
+    bool waited = false;
+    if (count > 0) {
+        stats.n_waves_run++;
+        for (size_t i = first; i < first + count; i++) {
+            const int32_t e  = sl.uniq[i];
+            const auto    it = sl.expert_slot.find(e);
+            if (it != sl.expert_slot.end()) {
+                // already in the cache (resident, or still loading from the previous wave's preload)
+                const int32_t s = it->second;
+                if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+                    enqueue_weights_locked(sl, e, s); // promote to demand, wait for it
+                    waited = true;
+                } else {
+                    stats.n_preload_ready++; // resident from the previous wave's preload
+                }
+                stats.n_hit++;
+                sl.keep[s] = 1;
+                sl.demand_slots.push_back(s);
+            } else {
+                // miss: evict a non-kept slot and queue the load
+                int32_t v;
+                while ((v = pick_victim_locked(sl, sl.keep.data())) < 0) {
+                    cv_done.wait(lk);
+                    if (load_failed) {
+                        GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+                    }
+                }
+                if (!sl.seen[e]) {
+                    stats.n_miss_cold++;
+                }
+                reserve_slot_locked(sl, e, v);
+                enqueue_weights_locked(sl, e, v);
+                stats.n_miss++;
+                waited = true;
+                sl.keep[v] = 1;
+                sl.demand_slots.push_back(v);
+            }
+        }
+    }
+
+    // best-effort preload of the next wave so its loads overlap this wave's compute; never waits,
+    //   whatever cannot be reserved now simply becomes the next wave's demand load
+    if (std::getenv("LLAMA_MOE_STREAM_NO_PRELOAD") == nullptr) {
+        for (size_t i = nfirst; i < nfirst + ncount; i++) {
+            const int32_t e = sl.uniq[i];
+            if (sl.expert_slot.find(e) != sl.expert_slot.end()) {
+                continue;
+            }
+            const int32_t v = pick_victim_locked(sl, sl.keep.data());
+            if (v < 0) {
+                continue;
+            }
+            if (!sl.seen[e]) {
+                stats.n_miss_cold++;
+            }
+            reserve_slot_locked(sl, e, v);
+            sl.keep[v] = 1;
+            enqueue_weights_locked(sl, e, v);
+            stats.n_preload_issued++;
+        }
+    }
+
+    if (waited) {
+        const int64_t t0 = ggml_time_us();
+        cv_done.wait(lk, [&]{
+            if (load_failed) {
+                return true;
+            }
+            for (const int32_t s : sl.demand_slots) {
+                if (sl.slot_state[s] != LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+                    return false;
+                }
+            }
+            return true;
+        });
+        if (load_failed) {
+            GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+        }
+        stats.t_stall_wave_us += ggml_time_us() - t0;
+    }
+
+    // parking pool: this wave's own resident slots plus the borrowed ones (all keep-protected;
+    //   the next same-layer reservation is ordered after this wave's GEMMs by the graph)
+    sl.plan_pool = sl.demand_slots;
+    sl.plan_pool.insert(sl.plan_pool.end(), borrowed.begin(), borrowed.end());
+    GGML_ASSERT(sl.plan_pool.size() >= n_ids);
+}
+
+// write out[i] = the cache slot the GEMM should index for each (token, expert) pair of wave w, one
+// token row at a time: pairs whose expert is in this wave get its real slot; the rest park on distinct
+// resident pool slots (pool_used prevents a repeat within the row, required by the Metal kernel)
+void llama_moe_stream::emit_wave_slots(llama_moe_stream_layer & sl, const int32_t * ids, int32_t * out,
+        int32_t w, uint32_t n_ids, int64_t n_tok) {
+    for (int64_t t = 0; t < n_tok; t++) {
+        sl.pool_used.clear();
+
+        // pass 1: pairs whose expert belongs to this wave -> that expert's real (resident) slot
+        for (uint32_t kk = 0; kk < n_ids; kk++) {
+            const int64_t i = t*n_ids + kk;
+            const int32_t e = ids[i];
+            GGML_ASSERT(sl.expert_wave[e] != 0xff);
+            if (sl.expert_wave[e] == (uint8_t) w) {
+                const int32_t s = sl.expert_slot.at(e);
+                GGML_ASSERT(sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_RESIDENT);
+                sl.slot_last_use[s] = ++sl.use_counter;
+                out[i] = s;
+                sl.pool_used.push_back(s);
+            }
+        }
+
+        // pass 2: the remaining (masked) pairs -> the next pool slot not yet used in this row
+        size_t pi = 0;
+        for (uint32_t kk = 0; kk < n_ids; kk++) {
+            const int64_t i = t*n_ids + kk;
+            if (sl.expert_wave[ids[i]] == (uint8_t) w) {
+                continue;
+            }
+            while (std::find(sl.pool_used.begin(), sl.pool_used.end(), sl.plan_pool[pi]) != sl.pool_used.end()) {
+                pi++;
+                GGML_ASSERT(pi < sl.plan_pool.size());
+            }
+            GGML_ASSERT(sl.slot_state[sl.plan_pool[pi]] == LLAMA_MOE_STREAM_SLOT_RESIDENT);
+            out[i] = sl.plan_pool[pi];
+            sl.pool_used.push_back(sl.plan_pool[pi]);
+            pi++;
+        }
+    }
+}
+
+// Custom-op callback for one pass of multi-pass prefill. When a ubatch touches more experts than the
+// cache holds, build_moe_ffn runs the expert GEMMs in several waves; this runs once per wave (single-
+// threaded on ith 0), in wave order. For wave w it makes that wave's expert slice resident (preloading
+// the next wave), then writes the slot ids the GEMM indexes - see plan_waves_locked / stage_wave_locked
+// / emit_wave_slots. The router's expert choice is untouched, so the output matches a non-streamed run.
+void llama_moe_stream_wave_ids(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    auto * ud  = (llama_moe_stream_wave *) userdata;
+    auto * sl  = ud->sl;
+    auto * mgr = sl->mgr;
+
+    const int32_t w = ud->wave;
+
+    const ggml_tensor * a = dst->src[0]; // contiguous selected ids
+    GGML_ASSERT(a->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_nelements(dst) == ggml_nelements(a));
+    GGML_ASSERT(dst->data != a->data); // the emit must not clobber the ids other waves read
+
+    const int64_t   n   = ggml_nelements(a);
+    const int32_t * ids = (const int32_t *) a->data;
+          int32_t * out = (int32_t *) dst->data;
+
+    std::unique_lock<std::mutex> lk(mgr->mtx);
+
+    if (mgr->load_failed) {
+        GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+    }
+
+    mgr->stats.n_wave_calls++;
+
+    if (w == 0) {
+        mgr->plan_waves_locked(*sl, ids, n);
+    }
+    GGML_ASSERT(sl->plan_next_wave == w); // waves must run in order (enforced by the graph ordering token)
+
+    const uint32_t n_ids = (uint32_t) a->ne[0]; // experts per token (n_expert_used)
+
+    mgr->stage_wave_locked(lk, *sl, w, n_ids); // make this wave resident, preload the next, build the pool
+    sl->plan_next_wave = w + 1;
+
+    mgr->emit_wave_slots(*sl, ids, out, w, n_ids, a->ne[1]);
+}
+
+// multi-pass prefill: 1.0 for pairs whose expert belongs to wave w, 0.0 otherwise; multiplied into
+// this wave's expert GEMM output so the masked-out (parked) pairs contribute nothing to the sum
+void llama_moe_stream_wave_mask(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    auto * ud  = (llama_moe_stream_wave *) userdata;
+    auto * sl  = ud->sl;
+    auto * mgr = sl->mgr;
+
+    const int32_t w = ud->wave;
+
+    const ggml_tensor * a = dst->src[0]; // contiguous selected ids
+    GGML_ASSERT(a->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_nelements(dst) == ggml_nelements(a));
+
+    const int64_t   n   = ggml_nelements(a);
+    const int32_t * ids = (const int32_t *) a->data;
+          float   * out = (float *) dst->data;
+
+    std::lock_guard<std::mutex> lock(mgr->mtx);
+
+    GGML_ASSERT(sl->plan_next_wave > w); // this wave's ids op has already run
+
+    for (int64_t i = 0; i < n; i++) {
+        out[i] = sl->expert_wave[ids[i]] == (uint8_t) w ? 1.0f : 0.0f;
+    }
+}
diff --git a/src/llama-moe-stream.h b/src/llama-moe-stream.h
new file mode 100644
index 000000000..421d7bc2e
--- /dev/null
+++ b/src/llama-moe-stream.h
@@ -0,0 +1,390 @@
+#pragma once
+
+#include "llama-mmap.h"
+
+#include "ggml-cpp.h"
+
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+// SSD streaming of MoE routed expert weights
+//
+// Streamed layers do not materialize their ffn_*_exps tensors; instead each weight gets a
+// device-side cache tensor of n_slots expert slabs, filled on demand from the GGUF file by an
+// id-remapping custom op that runs on the CPU right after the router top-k. The remap only
+// changes which cache slot an expert id resolves to - it never changes which experts the router
+// selected, so streaming affects latency, not outputs.
+//
+// Missing experts are loaded by a pool of I/O threads while the remap op waits; eviction is by
+// decaying route hotness with an LRU tiebreak. Reads are buffered by default, or O_DIRECT with
+// LLAMA_MOE_STREAM_DIRECT=1 (bypasses the page cache; recommended when the model far exceeds RAM).
+//
+// note: multiple contexts decoding the same streamed model concurrently are not supported -
+// one context can evict slots referenced by the other's in-flight graph.
+
+struct llama_moe_stream;
+
+enum llama_moe_stream_slot_state : uint8_t {
+    LLAMA_MOE_STREAM_SLOT_EMPTY    = 0,
+    LLAMA_MOE_STREAM_SLOT_LOADING  = 1, // reserved, load queued or in flight
+    LLAMA_MOE_STREAM_SLOT_RESIDENT = 2,
+};
+
+// one streamed weight tensor (gate/up/down or fused gate_up) of one layer
+struct llama_moe_stream_weight {
+    ggml_tensor * cache = nullptr; // cache tensor {ne0, ne1, n_slots}
+
+    uint16_t file_idx  = 0; // GGUF split file index
+    size_t   offs      = 0; // file offset of the full exps tensor data
+    size_t   nb_expert = 0; // bytes per expert slab
+};
+
+struct llama_moe_stream_layer;
+
+// userdata of one wave's custom ops (multi-pass prefill): identifies which pass this is
+struct llama_moe_stream_wave {
+    llama_moe_stream_layer * sl   = nullptr;
+    int32_t                  wave = -1;
+};
+
+// per-layer streaming state - also the userdata of the id-remapping custom op
+struct llama_moe_stream_layer {
+    llama_moe_stream * mgr = nullptr;
+
+    int32_t  il       = -1;
+    uint32_t n_expert = 0;
+    uint32_t n_slots  = 0;
+
+    std::vector<llama_moe_stream_weight> weights; // 2 (fused gate_up + down) or 3 entries
+
+    // residency state, guarded by mgr->mtx
+    std::vector<int32_t>                 slot_expert;   // [n_slots] expert id or -1
+    std::vector<uint8_t>                 slot_state;    // [n_slots] llama_moe_stream_slot_state
+    // One queue item per (slot, weight), so the gate, up and down slabs of an expert load on
+    // three workers at once. Loading them one after another on a single worker tripled the time a
+    // layer waits, and the remap waits for the slowest expert of the layer - so that serial chain
+    // set the decode rate. Both are bitmasks over weight index.
+    std::vector<uint32_t>                slot_claimed;  // [n_slots] weights a worker owns
+    std::vector<uint32_t>                slot_done;     // [n_slots] weights already loaded
+    std::vector<uint64_t>                slot_gen;      // [n_slots] reservation generation
+    std::vector<int64_t>                 slot_last_use; // [n_slots] LRU stamps
+    std::unordered_map<int32_t, int32_t> expert_slot;   // RESIDENT and LOADING entries
+
+    std::vector<uint32_t> route_hotness; // [n_expert] decayed selection counts, for eviction
+    // Undecayed selection counts. route_hotness is halved every 64 tokens so that eviction
+    // tracks recency, which also means an expert used steadily but rarely decays to 0 and
+    // disappears from the saved ranking - capping how deep a warm can go. The residency tier
+    // wants the opposite: a complete frequency ranking of everything the model actually uses.
+    std::vector<uint32_t> route_total;   // [n_expert]
+    std::vector<uint8_t>  seen;          // [n_expert] for cold-miss attribution
+    int64_t use_counter = 0;
+
+    // scratch for the remap callback
+    std::vector<int32_t> uniq;
+    std::vector<uint8_t> touched;
+    std::vector<uint8_t> keep;         // [n_slots] slots the current call must not evict
+    std::vector<int32_t> demand_slots; // slots the current call waits on
+
+    // wave plan for multi-pass prefill (guarded by mgr->mtx): the touched experts are split into
+    // plan_n_waves passes of at most plan_capacity experts each, run one pass at a time
+    uint32_t plan_capacity  = 0;  // experts per wave, set at graph build
+    uint32_t plan_n_waves   = 0;  // waves of the current call
+    int32_t  plan_next_wave = -1; // wave expected to run next (ordering guard)
+    std::vector<uint8_t> expert_wave; // [n_expert] wave each touched expert belongs to, 0xff = untouched
+    std::vector<int32_t> plan_pool;   // resident slots the masked-out pairs of this wave park on
+    std::vector<int32_t> pool_used;   // scratch: pool slots already used in the current token row
+
+    std::vector<std::unique_ptr<llama_moe_stream_wave>> wave_ud; // stable per-wave op userdata
+
+    // stable userdata for wave w (grows lazily); called at graph build time only
+    llama_moe_stream_wave * wave_userdata(int32_t wave, uint32_t capacity);
+
+    uint32_t weights_mask() const { return (1u << weights.size()) - 1u; }
+
+    // whether the exps tensors passed to build_moe_ffn are this layer's cache tensors
+    // (e.g. grovemoe evaluates a second, unstreamed expert group on the same layer index)
+    bool matches(const ggml_tensor * gate, const ggml_tensor * up,
+                 const ggml_tensor * down, const ggml_tensor * gate_up) const;
+};
+
+// one queued expert load
+struct llama_moe_stream_work {
+    llama_moe_stream_layer * sl = nullptr;
+
+    int32_t  expert = -1;
+    int32_t  slot   = -1;
+    int32_t  widx   = 0; // index into layer->weights
+    uint64_t gen    = 0; // stale unless it matches slot_gen[slot]
+    uint32_t heat   = 0; // snapshot of route_total[expert], for the page-cache admission band
+};
+
+// one slab that has been read into staging and is waiting to go over PCIe
+struct llama_moe_stream_upload {
+    llama_moe_stream_layer * sl = nullptr;
+    int32_t  slot = -1;
+    int32_t  widx = 0;
+    uint64_t gen  = 0;
+    int32_t  buf  = -1;        // staging pool index, or -1 when src is used
+    const uint8_t * src = nullptr; // a page-locked hot-file slab: no staging needed
+};
+
+struct llama_moe_stream {
+    uint32_t n_slots      = 0; // expert cache slots per streamed layer
+    int32_t  n_io_threads = 0;
+
+    std::vector<std::unique_ptr<llama_moe_stream_layer>> layers; // [n_layer], null = not streamed
+
+    llama_moe_stream(uint32_t n_layer, uint32_t n_slots, int32_t n_io_threads, bool direct);
+    ~llama_moe_stream();
+
+    llama_moe_stream_layer * layer(int32_t il) const {
+        return il >= 0 && (size_t) il < layers.size() ? layers[il].get() : nullptr;
+    }
+
+    // registers a streamed weight of layer il and returns its cache tensor
+    ggml_tensor * create_cache_tensor(
+            int32_t il, ggml_backend_buffer_type_t buft, const ggml_tensor * meta,
+            uint16_t file_idx, size_t offs);
+
+    // allocate the cache tensor buffers (after all create_cache_tensor calls)
+    void alloc_bufs(bool no_alloc);
+
+    // reopen the GGUF files for streaming reads
+    void open_files(const std::vector<std::string> & paths);
+
+    // keep the loader's mappings so a slab can be uploaded straight from the mapped file instead
+    // of being copied into staging by a read first; verifies one slab before it trusts them
+    void set_mappings(const llama_mmaps & mappings);
+
+    std::vector<const uint8_t *> map_addr; // per file, null when not mapped or not trusted
+    std::vector<size_t>          map_size;
+
+    // Off by default: uploading from the mapping removes the read, but then the page faults happen
+    // inside the CUDA copy, one cluster at a time and serialized across workers. Measured 2x worse
+    // than reading into staging. LLAMA_MOE_STREAM_MMAP_COPY=1 to try it anyway.
+    bool use_mmap_copy = false;
+
+    llama_memory_ranges pf_ranges; // scratch for the per-call batched prefetch, guarded by mtx
+
+    size_t size_bufs() const;
+
+    void print_stats() const;
+
+    // Persisted route hotness, so a restart does not have to rediscover the hot expert set.
+    // Reaching steady state from empty takes 400-600 tokens here, most of it spent filling the
+    // OS page cache by demand misses; replaying a saved ranking pulls that work forward.
+    // LLAMA_MOE_STREAM_HEAT=<path> enables both halves. Steady-state speed is unchanged -
+    // residency was measured not to set it - this only shortens the warm-up.
+    void save_heat() const;
+    void warm_from_heat();
+
+    std::string heat_path;    // empty = disabled
+    int64_t     heat_save_every = 0; // remap calls between saves (0 = only at shutdown)
+    int64_t     heat_last_save  = 0;
+    double      warm_extra_gb = 0.0; // LLAMA_MOE_STREAM_WARM_GB: also pull this much into the
+                                     // page cache beyond what fits in the device cache
+    void print_stats_delta(); // compact periodic line while LLAMA_MOE_STREAM_DEBUG is set
+
+    // pinned host buffer type of the cache device, or null when the backend has none
+    ggml_backend_buffer_type_t pinned_buft() const;
+
+    // distinct bytes-per-expert of the streamed weights of one layer (gate, up, down)
+    std::vector<size_t> slab_sizes() const;
+
+    bool use_pinned_staging = true; // LLAMA_MOE_STREAM_PINNED=0 to force plain host memory
+
+    int64_t dbg_every     = 0; // remap calls between periodic stat lines (0 = off)
+    int64_t dbg_last_call = 0;
+    struct { int64_t hit=0, miss=0, cold=0, stall=0, buf=0, nobuf=0, read=0, up=0,
+                     fast=0, med=0, slow=0, remap=0; } dbg_prev;
+
+    bool use_direct_io = false; // O_DIRECT streaming reads (LLAMA_MOE_STREAM_DIRECT), no page cache
+
+    llama_files files; // privately reopened GGUF files, same indices as the loader's
+
+    // OS-page-cache admission band (LLAMA_MOE_STREAM_ADMIT=lo:hi, over route_hotness).
+    //
+    // Every buffered read of an expert slab also installs it in the page cache, which is the L2
+    // behind the VRAM cache. That is indiscriminate: a cold expert touched once evicts a warm one,
+    // and an expert hot enough to hold an L1 slot forever is cached twice over - in VRAM and in
+    // RAM - for no benefit. Slabs whose route hotness falls outside [lo, hi] are read with
+    // FILE_FLAG_NO_BUFFERING instead, so they neither consult nor disturb the page cache.
+    uint32_t admit_lo = 0;
+    uint32_t admit_hi = UINT32_MAX;
+
+    // One handle PER I/O WORKER per file, not one shared handle per file.
+    //
+    // A Windows file HANDLE opened without FILE_FLAG_OVERLAPPED is a *synchronous* file object:
+    // the I/O manager holds its lock for the duration of every ReadFile, so concurrent positional
+    // reads through one handle queue behind each other however many threads issue them. Measured
+    // on this drive with 6 threads and 448 KiB reads (bench/qd.py):
+    //      one shared handle    0.86 GB/s unbuffered / 1.81 GB/s buffered
+    //      one handle each      2.21 GB/s unbuffered / 5.80 GB/s buffered
+    // That single-handle serialization is why --moe-stream-io-threads, splitting an expert into
+    // three parallel weight loads, and removing the old global io mutex all measured as no-ops:
+    // the queue depth was pinned at 1 by the file object, not by the caller.
+    std::vector<std::vector<void *>> h_nobuf; // [worker][file] FILE_FLAG_NO_BUFFERING, or empty
+
+    // Expert slabs are read at random over a file far larger than RAM. fopen leaves the Windows
+    // cache manager free to apply its sequential heuristics, which read ahead past each slab and
+    // mark the pages for early trim - wasted bandwidth, and it evicts the slabs worth keeping.
+    // FILE_FLAG_RANDOM_ACCESS turns both off while keeping the reads buffered.
+    std::vector<std::vector<void *>> h_rand; // [worker][file]
+    bool one_handle = false; // LLAMA_MOE_STREAM_ONE_HANDLE=1: route every worker through set 0
+    bool use_random_access = true; // LLAMA_MOE_STREAM_RANDOM_ACCESS=0 to use the plain handles
+
+    bool serial_io = false; // LLAMA_MOE_STREAM_SERIAL_IO=1 restores the old seek+read under a lock
+
+    bool l2_direct = false; // LLAMA_MOE_STREAM_L2_DIRECT=1 uploads from the arena, no pinned staging
+
+    // Writable host memory can be pinned here even though read-only mappings cannot
+    // (cudaDevAttrHostRegisterSupported is 1, ReadOnlySupported is 0), so the L2 arena can be
+    // pinned and uploaded from directly - which removes the arena->staging copy.
+    // LLAMA_MOE_STREAM_L2_PIN=0 to keep it pageable.
+    bool l2_pin = true;
+
+    bool split_weights = true; // LLAMA_MOE_STREAM_SPLIT_WEIGHTS=0 loads an expert on one worker
+
+    // LLAMA_MOE_STREAM_TRACE=<path> appends every decode routing decision as
+    //   int32 layer, int32 n_ids, int32 ids[n_ids]
+    // so cache policies can be scored offline against the same trace
+    FILE * trace = nullptr;
+
+    size_t  max_nb_expert      = 0;
+    int64_t hot_decay_interval = 0; // remap calls between route-hotness halvings (0 = no decay)
+
+    std::vector<std::pair<ggml_backend_buffer_type_t, ggml_context_ptr>> ctxs; // one per buft
+    std::vector<ggml_backend_buffer_ptr> bufs;
+
+    // load pool (queue and all layer residency state guarded by mtx)
+    mutable std::mutex      mtx;
+    std::condition_variable cv_work; // queued work or shutdown
+    std::condition_variable cv_done; // a load committed or failed
+
+    std::deque<llama_moe_stream_work> q_demand;
+
+    std::vector<std::thread> workers;
+    bool workers_started = false;
+    bool shutting_down   = false;
+    bool load_failed     = false;
+
+    bool debug = false;
+
+    struct {
+        int64_t n_calls     = 0; // remap invocations
+        int64_t n_hit       = 0; // touched experts already resident or loading
+        int64_t n_miss      = 0; // demand loads issued
+        int64_t n_miss_cold = 0; // first-ever touch of an expert
+        int64_t t_stall_us  = 0; // wait time in miss handling
+        int64_t t_remap_us  = 0; // whole remap callback, wait included - the serial MoE cost
+        int64_t t_read_us   = 0; // summed over workers, so it can exceed wall time
+        int64_t t_upload_us = 0; // host -> device copy of the slabs
+
+        // slab reads bucketed by latency: a page-cache hit is a memcpy and lands far below the
+        // time even one NVMe read takes, so the split says how much of the tail is really on disk
+        int64_t n_fast = 0; // < 150 us
+        int64_t n_med  = 0; // < 600 us
+        int64_t n_slow = 0;
+
+        int64_t n_buffered   = 0; // slab reads that went through the page cache (inside the band)
+        int64_t n_unbuffered = 0; // slab reads that bypassed it (outside the band)
+
+        int64_t n_wave_calls     = 0; // wave-ids invocations (>= n_calls under multi-pass prefill)
+        int64_t n_waves_run      = 0; // non-empty waves
+        int64_t n_preload_issued = 0; // next-wave loads started during a wave's compute
+        int64_t n_preload_ready  = 0; // wave experts already resident from the previous preload
+        int64_t t_stall_wave_us  = 0; // wait time in wave miss handling
+    } stats;
+
+    // Page-locked hot-expert file (LLAMA_MOE_STREAM_HOT=<path>, built by bench/mkhot.py).
+    //
+    // A page-cache hit is cheap in I/O terms and expensive in memory terms: ReadFile memcpies
+    // the slab into pinned staging and the DMA then reads those bytes back, so delivering one
+    // byte to VRAM costs three passes over DRAM. On DDR4-2400 that, not the SSD, is what the
+    // stall is made of.
+    //
+    // ggml's own host registration asks for cudaHostRegisterReadOnly, which WDDM does not
+    // support here, so a read-only GGUF mapping can never be locked. A mapping opened
+    // READ-WRITE can be: measured 9.6-11.7 GB/s of DMA straight out of a registered 12 GiB
+    // file mapping with no copy at all (scratchpad/pinmap.cu). So the hottest experts get
+    // their own file, mapped read-write, locked once at startup, and uploaded in place -
+    // one DRAM pass instead of three, and locked pages can never fall back to disk.
+    std::string hot_path;              // empty = disabled
+    void *      hot_base = nullptr;    // the mapped, locked region
+    size_t      hot_size = 0;
+    void *      hot_file = nullptr;    // Windows HANDLEs, kept so they can be closed
+    void *      hot_map  = nullptr;
+    bool        hot_locked = false;
+    bool      (*host_lock)(void *, size_t) = nullptr;
+    void      (*host_unlock)(void *)       = nullptr;
+    // (split index << 48 | byte offset of the slab in that split) -> offset inside hot_base.
+    // Keyed on where the slab lives in the GGUF, never on (layer, weight position): a layer's
+    // weights are registered in model-builder order, and qwen4exp creates ffn_down_exps before
+    // gate/up, so a positional key silently serves the wrong tensor - fast, and all "!!!!".
+    std::unordered_map<uint64_t, size_t> hot_index;
+
+    void open_hot_file();
+    void close_hot_file();
+    const uint8_t * hot_lookup(uint16_t file_idx, size_t src_offs, size_t nb) const;
+
+    // Decoupled upload.
+    //
+    // With the read and the upload done back to back on the same worker, a layer costs
+    // (slowest read) + (all of its uploads), because every item's read finishes at about the
+    // same moment and the copies then queue on the one copy engine. Reads go through a staging
+    // pool instead and one uploader thread drains it, so a slab crosses PCIe while the other
+    // workers are still reading, and the uploader synchronizes once per drain rather than once
+    // per slab - 10.3 -> 12.8 GB/s on this link (scratchpad/h2d.cu).
+    //
+    // MEASURED: this loses slightly (10.5-10.7 vs 10.9 tok/s), so it is OFF by default -
+    // LLAMA_MOE_STREAM_ASYNC_UP=1 to enable. The reason it does not pay here is that a layer
+    // only has ~8 slabs and they finish reading at very different times (page cache ~150 us,
+    // disk ~800 us), so the uploader drains one or two at a time and never forms the batch
+    // the one-sync-per-batch win needs, while the extra hand-off costs a thread wake per slab.
+    void (*h2d_async)(ggml_tensor *, const void *, size_t, size_t) = nullptr;
+    void (*h2d_sync)(void) = nullptr;
+    bool async_upload = false;
+
+    ggml_backend_buffer_t         staging_buf = nullptr; // one pinned allocation, n_staging slabs
+    uint8_t *                     staging_base = nullptr;
+    size_t                        staging_stride = 0;
+    int32_t                       n_staging = 0;
+    std::vector<int32_t>          staging_free;  // free list of slab indices
+    std::deque<llama_moe_stream_upload> q_upload;
+    std::condition_variable       cv_upload;     // work for the uploader, or a freed staging slab
+    std::thread                   uploader;
+
+    void uploader_loop();
+    bool init_staging_pool();
+    void free_staging_pool();
+
+    // internals
+    void start_workers_locked();
+    void worker_loop(int32_t wid);
+    int32_t pick_victim_locked(llama_moe_stream_layer & sl, const uint8_t * keep) const;
+    void reserve_slot_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot);
+    void enqueue_weights_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot);
+
+    // multi-pass prefill helpers (called by llama_moe_stream_wave_ids, all under mtx)
+    void plan_waves_locked(llama_moe_stream_layer & sl, const int32_t * ids, int64_t n); // wave 0: build the plan
+    void stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids); // make wave w resident + preload next
+    void emit_wave_slots(llama_moe_stream_layer & sl, const int32_t * ids, int32_t * out, int32_t w, uint32_t n_ids, int64_t n_tok); // write the slot ids
+};
+
+// callback of the id-remapping custom op inserted by build_moe_ffn
+void llama_moe_stream_remap(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata);
+
+// callbacks of the multi-pass prefill custom ops inserted by build_moe_ffn when a ubatch touches
+// more experts than the cache holds; each src[0] is the contiguous selected ids
+//   wave_ids:  makes wave w's expert slice resident and emits slot ids (masked pairs park on a pool)
+//   wave_mask: emits 1.0 for pairs belonging to wave w, 0.0 otherwise
+void llama_moe_stream_wave_ids (ggml_tensor * dst, int ith, int nth, void * userdata);
+void llama_moe_stream_wave_mask(ggml_tensor * dst, int ith, int nth, void * userdata);
diff --git a/src/llama.cpp b/src/llama.cpp
index e97272c88..ea8dfcecb 100644
--- a/src/llama.cpp
