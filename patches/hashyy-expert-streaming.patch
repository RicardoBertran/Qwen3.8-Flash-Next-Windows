+// sizes the per-layer table and clamps the I/O thread count; workers are spawned lazily on first use
+llama_moe_stream::llama_moe_stream(uint32_t n_layer, uint32_t n_slots, int32_t n_io_threads, bool direct) : n_slots(n_slots) {
+    layers.resize(n_layer);
+
+    this->n_io_threads = n_io_threads <= 0 ? MOE_STREAM_IO_THREADS_DEFAULT : n_io_threads;
+    this->n_io_threads = std::min<int32_t>(this->n_io_threads, MOE_STREAM_IO_THREADS_MAX);
+
+    debug         = std::getenv("LLAMA_MOE_STREAM_DEBUG") != nullptr;
+
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_ADMIT")) {
+        long long lo = 0, hi = -1;
+        if (sscanf(e, "%lld:%lld", &lo, &hi) >= 1) {
+            admit_lo = lo > 0 ? (uint32_t) lo : 0;
+            admit_hi = hi > 0 ? (uint32_t) hi : UINT32_MAX;
+        }
+    }
+    // Reproduces the pre-fix behaviour - every worker through handle set 0 - so the cost of
+    // the shared synchronous file object can be A/B'd on one binary. See bench/qd.py.
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_ONE_HANDLE")) {
+        one_handle = atoi(e) != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_ASYNC_UP")) {
+        async_upload = atoi(e) != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_PINNED")) {
+        use_pinned_staging = atoi(e) != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_MMAP_COPY")) {
+        use_mmap_copy = atoi(e) != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_RANDOM_ACCESS")) {
+        use_random_access = atoi(e) != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_TRACE")) {
+        trace = fopen(e, "wb");
+        if (trace == nullptr) {
+            LLAMA_LOG_WARN("%s: cannot open trace file %s\n", __func__, e);
+        }
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_SPLIT_WEIGHTS")) {
+        split_weights = atoi(e) != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_L2_DIRECT")) {
+        l2_direct = atoi(e) != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_L2_PIN")) {
+        l2_pin = atoi(e) != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_SERIAL_IO")) {
+        serial_io = atoi(e) != 0;
+        if (serial_io) {
+            use_mmap_copy     = false;
+            use_random_access = false;
+        }
+    }
+    if (debug) {
+        dbg_every = 48*32;
+    }
+    use_direct_io = direct;
+}
+
+// stop and join the I/O workers before the cache buffers and files they use are destroyed
+llama_moe_stream::~llama_moe_stream() {
+    save_heat();
+
+    {
+        std::lock_guard<std::mutex> lock(mtx);
+        shutting_down = true;
+        q_demand.clear();
+    }
+    cv_work.notify_all();
+    cv_upload.notify_all();
+    for (auto & w : workers) {
+        w.join();
+    }
+    if (uploader.joinable()) {
+        uploader.join();
+    }
+    free_staging_pool();
+
+#ifdef _WIN32
+    for (const auto * v : { &h_nobuf, &h_rand }) {
+        for (const auto & per_file : *v) {
+            for (void * h : per_file) {
+                if (h != nullptr) {
+                    CloseHandle((HANDLE) h);
+                }
+            }
+        }
+    }
+#endif
+    h_nobuf.clear();
+    h_rand.clear();
+    close_hot_file();
+
+    if (trace != nullptr) {
+        fclose(trace);
+        trace = nullptr;
+    }
+}
