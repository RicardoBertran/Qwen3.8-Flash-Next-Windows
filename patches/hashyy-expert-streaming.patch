+void llama_moe_stream::alloc_bufs(bool no_alloc) {
+    // The split issue/wait upload entry points, if this backend has them. They are looked up
+    // through the registry because the CUDA backend is a separately loaded module.
+    for (const auto & [buft, ctx_ptr] : ctxs) {
+        ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+        if (dev == nullptr) {
+            continue;
+        }
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+        if (reg == nullptr) {
+            continue;
+        }
+        auto * a = (void (*)(ggml_tensor *, const void *, size_t, size_t))
+                   ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_h2d_async");
+        auto * y = (void (*)(void)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_h2d_sync");
+        if (host_lock == nullptr) {
+            host_lock = (bool (*)(void *, size_t))
+                        ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_host_lock");
+            host_unlock = (void (*)(void *))
+                        ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_host_unlock");
+        }
+        if (a != nullptr && y != nullptr) {
+            h2d_async = a;
+            h2d_sync  = y;
+            break;
+        }
+    }
+
+    for (auto & [buft, ctx_ptr] : ctxs) {
+        ggml_context * ctx = ctx_ptr.get();
+        if (ggml_get_first_tensor(ctx) == nullptr) {
+            continue;
+        }
+
+        ggml_backend_buffer_t buf;
+        if (no_alloc) {
+            buf = ggml_backend_buft_alloc_buffer(buft, /*size =*/ 0); // dummy buffer
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+                t->buffer = buf;
+            }
+        } else {
+            buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+        }
+        if (buf == nullptr) {
+            throw std::runtime_error(format("unable to allocate %s buffer for MoE expert streaming", ggml_backend_buft_name(buft)));
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        bufs.emplace_back(buf);
+
+        LLAMA_LOG_INFO("%s: %12s expert cache size = %8.2f MiB (%u slots per layer)\n",
+                __func__, ggml_backend_buffer_name(buf), ggml_backend_buffer_get_size(buf) / 1024.0 / 1024.0, n_slots);
+        if (debug) {
+            fprintf(stderr, "moe stream: %s cache %.2f MiB, %u slots/layer, slab %zu KiB, io threads %d, admit %u:%u, pinned %d, randacc %d\n",
+                    ggml_backend_buffer_name(buf), ggml_backend_buffer_get_size(buf) / 1024.0 / 1024.0,
+                    n_slots, max_nb_expert/1024, n_io_threads, admit_lo, admit_hi,
+                    (int) use_pinned_staging, (int) use_random_access);
+            fprintf(stderr, "moe stream: async upload %s\n",
+                    (async_upload && h2d_async != nullptr) ? "on" : "off");
+            fflush(stderr);
+        }
+    }
+}
