+static const uint32_t MOE_STREAM_IO_THREADS_DEFAULT = 9;
+static const uint32_t MOE_STREAM_IO_THREADS_MAX     = 32;
+static const int64_t  MOE_STREAM_HOT_DECAY_TOKENS   = 64;
+
+// O_DIRECT alignment: 4096 is a multiple of any device logical block size (512/4096), so it is
+// universally valid, and reading a few extra KB of head/tail padding per slab is negligible
+static const size_t MOE_STREAM_DIRECT_ALIGN = 4096;
+
+// saturating increment - route-hotness counters accumulate over a whole run and must not wrap
+static uint32_t sat_inc(uint32_t & c) {
+    if (c < UINT32_MAX - 1) {
+        c++;
+    }
+    return c;
+}
+
+// page-aligned allocation, required both for O_DIRECT reads and for Metal private-buffer uploads
+static void * moe_aligned_alloc(size_t n) {
+#ifdef _WIN32
+    return _aligned_malloc(n, MOE_STREAM_DIRECT_ALIGN);
+#else
+    void * p = nullptr;
+    if (posix_memalign(&p, MOE_STREAM_DIRECT_ALIGN, n) != 0) {
+        p = nullptr;
+    }
+    return p;
+#endif
+}
+
+static void moe_aligned_free(void * p) {
+#ifdef _WIN32
+    _aligned_free(p);
+#else
+    free(p);
+#endif
+}
+
+#ifdef _WIN32
+// positional read on a Windows HANDLE; see the note in llama_moe_stream_pread
+static bool llama_moe_stream_win_pread(void * handle, void * dst, size_t len, uint64_t offs) {
+    const HANDLE h = (HANDLE) handle;
+    uint8_t *    p = (uint8_t *) dst;
+    while (len > 0) {
+        OVERLAPPED ov = {};
+        ov.Offset     = (DWORD) (offs & 0xffffffffull);
+        ov.OffsetHigh = (DWORD) (offs >> 32);
+
+        DWORD       got  = 0;
+        const DWORD want = (DWORD) std::min<size_t>(len, 32u*1024*1024);
+        if (!ReadFile(h, p, want, &got, &ov) || got == 0) {
+            return false;
+        }
+        p    += got;
+        offs += got;
+        len  -= got;
+    }
+    return true;
+}
+
+// FILE_FLAG_NO_BUFFERING read: the bytes land in staging without passing through the page cache,
+// so this read neither hits nor fills the OS-page-cache L2. Offset, length and buffer must all be
+// sector-aligned, hence the head/tail padding - the caller's staging has 2*ALIGN of slack for it.
+static const uint8_t * llama_moe_stream_pread_nb(void * handle, uint8_t * staging, size_t len, size_t offs) {
+    const size_t a     = MOE_STREAM_DIRECT_ALIGN;
+    const size_t aoffs = offs & ~(a - 1);
+    const size_t head  = offs - aoffs;
+    const size_t total = ((head + len + a - 1)/a)*a;
+    if (!llama_moe_stream_win_pread(handle, staging, total, aoffs)) {
+        return nullptr;
+    }
+    return staging + head;
+}
+#endif
+
+// read len bytes at file offset offs into staging (thread-safe positional read); staging must have
+// room for len (+ 2*MOE_STREAM_DIRECT_ALIGN when direct). returns a pointer to the len bytes
+// within staging, or nullptr on failure
+static const uint8_t * llama_moe_stream_pread(llama_file & file, uint8_t * staging, size_t len, size_t offs, bool direct, bool serialize = false) {
+#ifdef _WIN32
+    GGML_UNUSED(direct);
+    // ReadFile honours the offset in OVERLAPPED even on a synchronous handle, and leaves the
+    // shared file pointer out of it, so this is a real positional read: no seek, no lock, and
+    // n_io_threads loads actually run concurrently. The seek+read pair this replaces needed a
+    // global mutex, which pinned every expert load to queue depth 1 - measured on this drive,
+    // the 490 KiB/879 KiB expert slabs run at ~1.0 GB/s at depth 1 and ~2.8 GB/s at depth 4.
+    if (serialize) {
+        static std::mutex io_mtx;
+        std::lock_guard<std::mutex> lock(io_mtx);
+        try {
+            file.seek(offs, SEEK_SET);
+            file.read_raw(staging, len);
+            return staging;
+        } catch (...) {
+            return nullptr;
+        }
+    }
+
+    const HANDLE h = (HANDLE) _get_osfhandle(file.file_id());
+    if (h == INVALID_HANDLE_VALUE) {
+        return nullptr;
+    }
+    if (!llama_moe_stream_win_pread(h, staging, len, offs)) {
+        return nullptr;
+    }
+    return staging;
+#else
+    const int fd = file.file_id();
+
+    if (direct) {
+        // O_DIRECT requires the offset, length, and buffer all block-aligned
+        const size_t a     = MOE_STREAM_DIRECT_ALIGN;
+        const size_t aoffs = offs & ~(a - 1);
+        const size_t head  = offs - aoffs;
+        const size_t total = ((head + len + a - 1)/a)*a;
+        ssize_t r;
+        do {
+            r = pread(fd, staging, total, aoffs);
+        } while (r < 0 && errno == EINTR);
+        if (r < 0 || (size_t) r < head + len) {
+            return nullptr;
+        }
+        return staging + head;
+    }
+
+    uint8_t * p    = staging;
+    size_t    left = len;
+    while (left > 0) {
+        const ssize_t r = pread(fd, p, left, offs);
+        if (r < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return nullptr;
+        }
+        if (r == 0) {
+            return nullptr; // unexpected EOF
+        }
+        p    += r;
+        offs += (size_t) r;
+        left -= (size_t) r;
+    }
+    return staging;
+#endif
+}
+
+// true iff all of the given exps tensors are this layer's cache tensors - guards against a second,
+// non-streamed expert group on the same layer index (e.g. grovemoe chexps)
+bool llama_moe_stream_layer::matches(const ggml_tensor * gate, const ggml_tensor * up,
+                                     const ggml_tensor * down, const ggml_tensor * gate_up) const {
+    auto is_cache = [this](const ggml_tensor * t) {
+        for (const auto & w : weights) {
+            if (w.cache == t) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    size_t n = 0;
+    for (const ggml_tensor * t : { gate, up, down, gate_up }) {
+        if (t == nullptr) {
+            continue;
+        }
+        if (!is_cache(t)) {
+            return false;
+        }
+        n++;
+    }
+
+    return n > 0 && n == weights.size();
+}
